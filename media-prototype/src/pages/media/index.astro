---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, conversations } from '../../lib/editorial';
import { articleStyle } from '../../lib/article-style';
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)).sort((a,b)=>Number(new Date(b.data.publication_date))-Number(new Date(a.data.publication_date)));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Publications — Scènes d’Arbitrage · Prototype</title><style is:inline set:html={articleStyle}/></head><body><main class="shell"><nav class="top"><span class="brand">SCÈNES D’ARBITRAGE</span><span class="small">PROTOTYPE — NON PUBLIC</span></nav><p class="kicker">PUBLICATIONS</p><h1>Découvrir les arbitrages</h1><p class="lead">Entretiens, regards croisés et analyses des décisions économiques.</p>{items.length===0?<p>Aucune publication autorisée pour l’instant.</p>:<div class="cards">{items.map(a=><article class="card"><p class="kicker">{a.data.cycle} · {conversations[a.data.cycle]?.[a.data.conversation]} · {readings[a.data.lecture_principale]}</p><h2><a href={urlOf(a.id)}>{a.data.title}</a></h2><p>{a.data.summary}</p></article>)}</div>}</main></body></html>
