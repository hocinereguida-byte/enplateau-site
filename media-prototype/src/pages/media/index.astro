---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, conversations, publicationInstant, cycleCatalogue, cycleFamilies } from '../../lib/editorial';
import { articleStyle } from '../../lib/article-style';
import { photoCycle, photoLecture, photoConversation, afficherPhotoListe } from '../../lib/photographies';
import registry from '../../../../content/rubriques/conversations.json';
import MediaFooter from '../../components/MediaFooter.astro';
import MediaHeader from '../../components/MediaHeader.astro';
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)).sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const ordered=[...items].sort((a,b)=>({une:0,secondaire:1,standard:2}[a.data.mise_en_avant||'standard']??2)-({une:0,secondaire:1,standard:2}[b.data.mise_en_avant||'standard']??2));
const featured=ordered[0];
const visualLead=ordered.find(a=>a.id!==featured?.id && a.data.hero_image) ?? ordered.find(a=>a.id!==featured?.id);
const remaining=ordered.slice(1,10);
const visual=remaining.filter((a,i)=>a.data.taille_image_liste==="sans"?false:a.data.taille_image_liste&&a.data.taille_image_liste!=="automatique"?true:afficherPhotoListe(a.data,"accueil",i+1));
const headlines=remaining.filter((a,i)=>a.data.taille_image_liste==="sans"?true:a.data.taille_image_liste&&a.data.taille_image_liste!=="automatique"?false:!afficherPhotoListe(a.data,"accueil",i+1));
const displaySize=(a:any,i:number)=>a.data.taille_image_liste==="grande"?"large":a.data.taille_image_liste==="moyenne"?"medium":a.data.taille_image_liste==="vignette"?"thumb":a.data.taille_image_liste==="sans"?"none":i%3===0?"medium":i%3===1?"thumb":"none";
const recentConversations=Object.entries(conversations).flatMap(([cycle,group])=>
  Object.entries(group).map(([code,title])=>{
    const articles=items.filter(a=>a.data.cycle===cycle&&a.data.conversation===code);
    const latest=articles.length ? (publicationInstant(articles[0].data.publication_date)?.getTime()??0) : 0;
    const meta=(registry.conversations as Record<string,{titre:string;presentation:string}>)[cycle+'_'+code];
    return {cycle,code,title,description:meta?.presentation||'',count:articles.length,latest,photo:photoConversation(cycle,code),url:`/media/cycles/${cycle}/conversations/${code}/`};
  })
).filter(item=>item.count>0).sort((a,b)=>b.latest-a.latest||a.cycle.localeCompare(b.cycle)||a.code.localeCompare(b.code)).slice(0,4);
---
<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"/><meta name="sda-preproduction-revision" content="ux-v4-20261112-redeploy-1"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Scènes d’Arbitrage — L’intelligence derrière les décisions</title><meta name="description" content="La fiction économique documentée pour explorer les décisions. Des Regards croisés fondés sur des sources réelles pour comprendre les mécanismes économiques."/><style is:inline set:html={articleStyle}/><style is:global>
.editorial-image-large .article-list-photo,.editorial-image-large .photo-placeholder{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
.editorial-image-medium .article-list-photo,.editorial-image-medium .photo-placeholder{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
.editorial-image-thumb{display:grid!important;grid-template-columns:minmax(0,1fr) 112px;gap:12px 20px;align-items:start}
.editorial-image-thumb .article-list-photo,.editorial-image-thumb .photo-placeholder{grid-column:2;grid-row:1/5;width:112px;height:84px;object-fit:cover;min-height:0;margin:0}
.editorial-image-thumb > :not(.article-list-photo):not(.photo-placeholder){grid-column:1}
