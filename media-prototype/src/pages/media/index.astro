---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, conversations, publicationInstant } from '../../lib/editorial';
import { articleStyle } from '../../lib/article-style';
import { photoCycle, photoLecture, afficherPhotoListe } from '../../lib/photographies';
import MediaFooter from '../../components/MediaFooter.astro';
import MediaHeader from '../../components/MediaHeader.astro';
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)).sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const ordered=[...items].sort((a,b)=>({une:0,secondaire:1,standard:2}[a.data.mise_en_avant||'standard']??2)-({une:0,secondaire:1,standard:2}[b.data.mise_en_avant||'standard']??2));
const featured=ordered[0];
const remaining=ordered.slice(1,10);
const visual=remaining.filter((a,i)=>afficherPhotoListe(a.data,"accueil",i+1));
const headlines=remaining.filter((a,i)=>!afficherPhotoListe(a.data,"accueil",i+1));
---
<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Scènes d’Arbitrage — Regards sur les décisions économiques</title><meta name="description" content="Comprendre les décisions qui façonnent l’économie, par les conversations, les situations concrètes et les regards professionnels."/><style is:inline set:html={articleStyle}/></head>
<body class="media-home">
<a class="skip" href="#contenu">Aller au contenu</a>
<MediaHeader active="accueil"/>
<main id="contenu" class="home-shell">
<section class="home-intro">
<p class="micro">REGARDS SUR LES DÉCISIONS ÉCONOMIQUES</p>
<h1>Les décisions ont plusieurs lectures.</h1>
<p class="home-standfirst">Comprendre les choix qui façonnent l’économie réelle, à travers des conversations et plusieurs regards professionnels.</p>
<div class="intro-links"><a href="/media/publications/">Explorer toutes les publications</a><a href="#cycles">Explorer les cycles</a></div>
</section>
<section id="publications" class="home-section home-editorial" aria-labelledby="publications-heading">
<div class="section-line"><div><p class="micro">À LA UNE</p><h2 id="publications-heading">Dernières publications</h2></div><a class="story-action" href="/media/publications/">Explorer le catalogue</a></div>
<div class="press-front-grid">
<div class="press-lead-column">
{featured ? <article class="featured-story press-lead-story">
<p class="story-label">{featured.data.cycle} / {conversations[featured.data.cycle]?.[featured.data.conversation]} / {readings[featured.data.lecture_principale]}</p>
{afficherPhotoListe(featured.data,"accueil",0)&&(featured.data.hero_image?<img class="article-list-photo featured-photo" src={featured.data.hero_image} alt={featured.data.seo?.image_alt||""} loading="eager"/>:<div class="photo-placeholder photo-placeholder-feature" role="img" aria-label="Photographie de l’article à venir"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>)}
<h3><a href={urlOf(featured.id)}>{featured.data.title}</a></h3>
{featured.data.summary&&<p>{featured.data.summary}</p>}
<a class="story-action" href={urlOf(featured.id)}>Lire l’article</a></article> : <p class="small">Les publications paraîtront ici dès leur mise en ligne.</p>}
<div class="press-secondary-grid">{visual.slice(0,4).map(a=><article class="press-visual-story">{a.data.hero_image?<img src={a.data.hero_image} alt={a.data.seo?.image_alt||""} loading="lazy"/>:<div class="photo-placeholder" role="img" aria-label="Photographie de l’article à venir"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>}<p class="micro">{a.data.cycle} · {readings[a.data.lecture_principale]}</p><h3><a href={urlOf(a.id)}>{a.data.title}</a></h3></article>)}</div>
</div>
<aside class="press-headlines" aria-label="Autres sujets"><p class="micro">À LIRE ÉGALEMENT</p>
{[...headlines,...visual.slice(4)].map(a=><article class="press-headline"><p class="micro">{a.data.cycle} · {readings[a.data.lecture_principale]}</p><h3><a href={urlOf(a.id)}>{a.data.title}</a></h3></article>)}
<a class="press-more" href="/media/publications/">Toutes les publications</a></aside>
</div>
</section>
<section class="home-section"><p class="micro">EXPLORER LES QUESTIONS</p><h2>Toutes les conversations</h2><p class="home-section-intro">Recherchez parmi les conversations économiques par sujet, secteur ou question.</p><a class="story-action" href="/media/conversations/">Rechercher une conversation</a></section><section id="cycles" class="home-section" aria-labelledby="cycles-heading">
<div class="section-line"><div><p class="micro">LES SECTEURS</p><h2 id="cycles-heading">Explorer les cycles</h2></div><span class="small">Deux premiers cycles · Sept conversations chacun</span></div>
<div class="cycle-list">
<a class="cycle-row" href="/media/cycles/industrie/">{photoCycle("industrie")?<img class="rubric-thumb" src={photoCycle("industrie")} alt="" loading="lazy"/>:<span class="photo-placeholder photo-placeholder-thumb">PHOTO DU CYCLE</span>}<span class="cycle-index">01 / INDUSTRIE</span><span class="cycle-title">Industrie et transformations industrielles</span><span class="cycle-description">Les décisions qui orientent la production, les investissements et les trajectoires industrielles.</span><span class="cycle-arrow" aria-hidden="true">↗</span></a>
<a class="cycle-row" href="/media/cycles/immobilier/">{photoCycle("immobilier")?<img class="rubric-thumb" src={photoCycle("immobilier")} alt="" loading="lazy"/>:<span class="photo-placeholder photo-placeholder-thumb">PHOTO DU CYCLE</span>}<span class="cycle-index">02 / IMMOBILIER</span><span class="cycle-title">Logement & fabrique des territoires</span><span class="cycle-description">Les décisions qui façonnent le logement, les opérations et les territoires.</span><span class="cycle-arrow" aria-hidden="true">↗</span></a>
</div>
</section>
<section id="lectures" class="home-section" aria-labelledby="lectures-heading">
<div class="section-line"><div><p class="micro">LES REGARDS</p><h2 id="lectures-heading">Lire selon votre expertise</h2></div></div>
<p class="home-section-intro">Une même question économique peut être abordée par la stratégie, la finance, le droit, les opérations ou d’autres disciplines. Retrouvez chaque lecture à travers les cycles.</p>
<div class="expertise-grid">{Object.entries(readings).map(([code,name])=><a class="expertise-link" href={`/media/lectures/${code}/`}>{photoLecture(code)?<img class="reading-tiny-photo" src={photoLecture(code)} alt="" loading="lazy"/>:<span class="reading-photo-placeholder" aria-hidden="true">PHOTO</span>}{name}<span aria-hidden="true">↗</span></a>)}</div>
</section>
<section class="home-section"><p class="micro">PARTAGER UNE EXPÉRIENCE</p><h2>Votre regard peut éclairer une conversation.</h2><p class="home-section-intro">Vous avez pris part à une décision ou observé un arbitrage utile à comprendre ? Signalez votre expérience à la rédaction, qui reste seule à l’initiative des entretiens.</p><a class="story-action" href="/media/proposer-un-eclairage/">Proposer un éclairage</a></section>
<section class="home-section newsletter-home"><p class="micro">GARDER LE FIL</p><h2>La lettre de Scènes d’Arbitrage</h2><p class="home-section-intro">Retrouvez les nouvelles conversations et les regards professionnels sur les décisions économiques.</p><a class="story-action" href="/media/newsletter/">Découvrir la newsletter</a></section>
</main>
<MediaFooter/>
</body></html>