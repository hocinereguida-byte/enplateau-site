---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, conversations, publicationInstant, cycleCatalogue, cycleFamilies, publicPerspectives, publicPerspectiveLabel, publicGenreLabel, perspectiveOf, publicCycleLabel } from '../../lib/editorial';
import { articleStyle } from '../../lib/article-style';
import MediaFooter from '../../components/MediaFooter.astro';
import MediaHeader from '../../components/MediaHeader.astro';
const articles=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)).sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const ordered=[...articles].sort((a,b)=>({une:0,secondaire:1,standard:2}[a.data.mise_en_avant||'standard']??2)-({une:0,secondaire:1,standard:2}[b.data.mise_en_avant||'standard']??2));
const featured=ordered[0];
const latest=articles.filter(a=>a.id!==featured?.id).slice(0,6);
const groups=Object.entries(conversations).flatMap(([cycle,entries])=>Object.entries(entries).map(([code,title])=>{
 const matching=articles.filter(a=>a.data.cycle===cycle&&a.data.conversation===code);
 return {cycle,code,title,count:matching.length,updated:matching.length ? (publicationInstant(matching[0].data.publication_date)?.getTime()??0) : 0,url:'/media/cycles/'+cycle+'/conversations/'+code+'/'};
})).filter(g=>g.count>0).sort((a,b)=>b.updated-a.updated);
const heroConversation=groups.find(g=>g.cycle===featured?.data.cycle&&g.code===featured?.data.conversation)??groups[0];
const genreLabel=(a:any)=>`${publicGenreLabel(a.data)} · ${publicCycleLabel(a.data.cycle)}`.toLocaleUpperCase('fr-FR');
const perspectiveLabel=(a:any)=>publicPerspectiveLabel(perspectiveOf(a.data));
const cycleLabel=publicCycleLabel;
---
<!doctype html>
<html lang="fr"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/>
<meta name="sda-preproduction-revision" content="formats-cartes-cycle-v7-1-20261112"/>
<title>Scènes d’Arbitrage — Les décisions qui font l’économie</title>
<meta name="description" content="La fiction pour explorer. L’analyse pour comprendre. Découvrez les arbitrages économiques à travers Raisons et déraisons, Les interrogatoires et Le fond du problème."/>
<style is:inline set:html={articleStyle}/></head>
<body class="media-home">
<a class="skip" href="#contenu">Aller au contenu</a><MediaHeader active="accueil"/>
<main class="sda-v5-home" id="contenu">
<section class="sda-v5-intro" aria-labelledby="home-title">
<p class="sda-v5-eyebrow">LE MÉDIA DES DÉCISIONS ÉCONOMIQUES</p>
<h1 id="home-title">Des histoires pour comprendre ce que choisir veut dire.</h1>
<p>La fiction pour explorer. L’analyse pour comprendre.</p>
</section>
<section class="sda-v5-hero" aria-label="Sélection de la rédaction">
<div class="sda-v5-feature"><p class="sda-v5-label">À LA UNE · SÉLECTION ÉDITORIALE</p>
{featured ? <>
<h2><a href={urlOf(featured.id)}>{featured.data.title}</a></h2>
{featured.data.summary&&<p>{featured.data.summary}</p>}
<a class="sda-v5-link sda-v5-dark-cta" href={urlOf(featured.id)}>Découvrir l’article <span aria-hidden="true">↗</span></a>
</> : <>
<h2>Les décisions derrière les apparences.</h2><p>Les premières publications seront proposées ici dès leur mise à disposition.</p>
<a class="sda-v5-link sda-v5-dark-cta" href="/media/cycles/">Explorer les secteurs <span aria-hidden="true">↗</span></a>
</>}
</div>
<aside class="sda-v5-hero-aside"><p class="sda-v5-label">POUR PROLONGER LA LECTURE</p>
{heroConversation ? <>
<h3>{heroConversation.title}</h3>
<p>{cycleLabel(heroConversation.cycle)} · {heroConversation.count} publication{heroConversation.count>1?'s':''} disponible{heroConversation.count>1?'s':''}</p>
<a class="sda-v5-link" href={heroConversation.url}>Explorer le sujet <span aria-hidden="true">↗</span></a>
</> : <>
<h3>Explorer par grande question</h3><p>Les grandes questions apparaissent dès leur première publication.</p>
<a class="sda-v5-link" href="/media/cycles/">Découvrir les secteurs <span aria-hidden="true">↗</span></a>
</>}
</aside></section>
<section class="sda-v5-section" aria-labelledby="home-latest">
<div class="sda-v5-section-head"><div><p class="sda-v5-label">LES PUBLICATIONS DISPONIBLES</p><h2 id="home-latest">Des lectures pour commencer</h2></div><a class="sda-v5-link" href="/media/publications/">Toutes les publications <span aria-hidden="true">↗</span></a></div>
{latest.length ? <div class="sda-v5-articles">{latest.map(a=><article class="sda-v5-article-card">
<p class="sda-v5-label">{genreLabel(a)}</p><h3><a href={urlOf(a.id)}>{a.data.title}</a></h3>
{a.data.summary&&<p>{a.data.summary}</p>}
<div class="sda-v5-card-footer"><span>{perspectiveLabel(a)||cycleLabel(a.data.cycle)}</span><a href={urlOf(a.id)}>Lire ↗</a></div>
</article>)}</div> : <p>Les premières publications apparaîtront ici dès leur mise en ligne.</p>}
</section>
<section class="sda-v5-explore" aria-labelledby="home-cycles">
<div class="sda-v5-section-head"><div><p class="sda-v5-label">SIX FAMILLES · VINGT SECTEURS</p><h2 id="home-cycles">Explorer l’économie, secteur par secteur</h2></div><a class="sda-v5-link" style="color:#eee!important" href="/media/cycles/">Voir tous les secteurs ↗</a></div>
<div class="sda-v5-families">{cycleFamilies.map((family,i)=><section class="sda-v5-family" aria-label={family.label}>
<small>{String(i+1).padStart(2,'0')} · {family.codes.length} SECTEURS</small>
<h3>{family.label}</h3>
{family.codes.map(code=><a href={'/media/cycles/'+code+'/'}>{cycleLabel(code)}</a>)}
</section>)}</div>
</section>
<section class="sda-v5-section" aria-labelledby="home-conversations">
<div class="sda-v5-section-head"><div><p class="sda-v5-label">LES GRANDES QUESTIONS</p><h2 id="home-conversations">Les sujets qui fâchent</h2></div><a class="sda-v5-link" href="/media/conversations/">Parcourir ↗</a></div>
{groups.length ? <div class="sda-v5-conversations">{groups.slice(0,6).map(g=><article class="sda-v5-conversation-card">
<p class="sda-v5-label">{cycleLabel(g.cycle)} · SUJET {g.code}</p>
<h3><a href={g.url}>{g.title}</a></h3><p>Une question économique explorée à travers différents arbitrages.</p>
<footer>{g.count} publication{g.count>1?'s':''} disponible{g.count>1?'s':''} · <a class="sda-v5-link" href={g.url}>Explorer ↗</a></footer>
</article>)}</div> : <p>Les sujets seront accessibles à partir de leur première publication.</p>}
</section>
<section class="sda-v5-section" aria-labelledby="home-angles">
<div class="sda-v5-section-head"><div><p class="sda-v5-label">HUIT POINTS DE VUE</p><h2 id="home-angles">Les angles morts</h2></div><a class="sda-v5-link" href="/media/lectures/">Explorer les huit regards ↗</a></div>
<p class="sda-v6-perspective-intro">Stratégie, finance, droit, opérations, technologie, ressources humaines, énergie et territoires : huit manières de comprendre ce qu’une décision laisse dans l’ombre.</p>
<div class="sda-v6-perspective-grid">{Object.entries(publicPerspectives).map(([code,entry])=><a class="sda-v6-perspective-card" href={'/media/lectures/'+code+'/'}>
<span class="sda-v5-label">{entry.label}</span><span>{entry.description}</span><span class="sda-v6-perspective-arrow" aria-hidden="true">↗</span>
</a>)}</div>
</section>
<aside class="sda-v5-bottom"><div><h2>Un média qui s’enrichit chaque semaine.</h2><p>Retrouvez les nouvelles publications et parcourez les secteurs sans changer vos repères.</p></div><a class="sda-v5-link" href="/media/publications/">Explorer le catalogue ↗</a></aside>
</main><MediaFooter/></body></html>
