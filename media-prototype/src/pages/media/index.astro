---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, conversations, contexts } from '../../lib/editorial';
import { articleStyle } from '../../lib/article-style';
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)).sort((a,b)=>Number(new Date(b.data.publication_date))-Number(new Date(a.data.publication_date)));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Publications — Scènes d’Arbitrage · Prototype</title><style is:inline set:html={articleStyle}/></head><body><div class="site-bar"><nav class="site-bar-inner"><a href="/media/" class="brand">SCÈNES D’ARBITRAGE</a><span class="site-label">PROTOTYPE — PRÉPRODUCTION</span></nav></div><main class="shell"><p class="kicker">SCÈNES D’ARBITRAGE · MÉDIA ÉCONOMIQUE</p><h1>Découvrir les arbitrages</h1><p class="lead">Entretiens, regards croisés et analyses des décisions économiques.</p><section class="panel"><p class="micro">EXPLORER PAR SECTEUR</p><div class="cards"><article class="card"><p class="kicker">CYCLE 01</p><h2><a href="/media/cycles/industrie/">Industrie et transformations industrielles</a></h2><p>Sept conversations et trois contextes pour comprendre les arbitrages industriels.</p></article><article class="card"><p class="kicker">CYCLE 02</p><h2><a href="/media/cycles/immobilier/">Logement & fabrique des territoires</a></h2><p>Sept conversations pour éclairer les décisions immobilières et territoriales.</p></article></div></section><section class="panel"><p class="micro">EXPLORER PAR EXPERTISE</p><div class="chips">{Object.entries(readings).map(([code,name])=><a class="chip" href={`/media/lectures/${code}/`}>{name}</a>)}</div></section><section class="panel"><h2>Dernières publications</h2>{items.length===0?<p>Aucune publication autorisée pour l’instant.</p>:<div class="cards">{items.map(a=><article class="card"><p class="kicker">{a.data.cycle} · {conversations[a.data.cycle]?.[a.data.conversation]} · {readings[a.data.lecture_principale]}</p><h2><a href={urlOf(a.id)}>{a.data.title}</a></h2><p>{a.data.summary}</p></article>)}</div>}</section></main></body></html>
