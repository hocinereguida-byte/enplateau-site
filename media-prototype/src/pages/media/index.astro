---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings } from '../../lib/editorial';
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)).sort((a,b)=>+new Date(b.data.publication_date!)-+new Date(a.data.publication_date!));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Prototype · Publications — Scènes d’Arbitrage</title><link rel="stylesheet" href="/media-prototype.css"/></head>
<body><main class="wrap"><p class="eyebrow">SCÈNES D’ARBITRAGE · PROTOTYPE</p><h1>Publications</h1><p>Articles publiés et validés uniquement. Aucun brouillon n’est affiché.</p>{items.length===0?<p class="empty">Aucun article publiable pour l’instant. C’est normal au stade du prototype.</p>:<div class="cards">{items.map(a=><article class="card"><p class="eyebrow">{a.data.cycle} / {readings[a.data.lecture_principale]}</p><h2><a href={urlOf(a.id)}>{a.data.title}</a></h2><p>{a.data.summary}</p></article>)}</div>}</main></body></html>
