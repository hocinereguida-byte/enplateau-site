---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, publicPerspectiveLabel, publicGenreLabel, publicPerspectives, conversations, contexts, publicationInstant, perspectiveOf, genreOf, narrativeGenres, cycleCatalogue, canonicalCycleCode } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
const articles=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)).sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const conversationFilterOptions={...conversations,numerique:conversations['numerique-telecom']||{}};
const contextFilterOptions={...contexts,numerique:contexts['numerique-telecom']||{}};
const entries=articles.map(a=>({
  title:a.data.title,
  summary:a.data.summary??'',
  hero_image:a.data.hero_image??'',
  taille_image_liste:a.data.taille_image_liste??'automatique',
  cycle:canonicalCycleCode(a.data.cycle),
  conversation:a.data.conversation,
  contexte:a.data.contexte,
  lecture:perspectiveOf(a.data),
  genre:genreOf(a.data)==='recit' ? 'chronique' : (genreOf(a.data) || (a.data.format==='regard-croise'?'regard-croise':'')),
  tags:[a.data.tag_1,a.data.tag_2,a.data.tag_3,a.data.tag_4,a.data.tag_5].filter(Boolean).join(' '),
  url:urlOf(a.id),
  conversationLabel:conversations[a.data.cycle]?.[a.data.conversation]??a.data.conversation,
  contextLabel:contexts[a.data.cycle]?.[a.data.contexte]??a.data.contexte,
  lectureLabel:publicPerspectiveLabel(perspectiveOf(a.data)),
  lectureTechnical:readings[perspectiveOf(a.data)]??'',
  formatLabel:publicGenreLabel(a.data)
}));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Toutes les publications — Scènes d’Arbitrage</title><meta name="description" content="Recherchez les fictions satiriques et les analyses journalistiques par secteur, grande question, situation et point de vue."/><style is:inline set:html={articleStyle}/><style is:global>
.editorial-image-large .article-list-photo,.editorial-image-large .photo-placeholder{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
.editorial-image-medium .article-list-photo,.editorial-image-medium .photo-placeholder{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
.editorial-image-thumb{display:grid!important;grid-template-columns:minmax(0,1fr) 112px;gap:12px 20px;align-items:start}
.editorial-image-thumb .article-list-photo,.editorial-image-thumb .photo-placeholder{grid-column:2;grid-row:1/5;width:112px;height:84px;object-fit:cover;min-height:0;margin:0}
.editorial-image-thumb > :not(.article-list-photo):not(.photo-placeholder){grid-column:1}
.editorial-image-none .article-list-photo,.editorial-image-none .photo-placeholder{display:none}
@media(max-width:600px){.editorial-image-thumb{grid-template-columns:minmax(0,1fr) 86px;gap:7px 12px}.editorial-image-thumb .article-list-photo,.editorial-image-thumb .photo-placeholder{width:86px;height:68px}}
</style></head><body>
<a href="#catalogue" class="skip">Aller au catalogue</a>
<MediaHeader/>
<main class="shell" id="catalogue"><p class="kicker"><a href="/media/">Accueil</a> / Publications</p><h1>Explorer les publications</h1><p class="lead">Découvrez les Comédies économiques, les Grands Entretiens et Le fond du problème. Retrouvez les contributions par secteur, question, situation ou angle mort.</p>
<form class="catalogue-filters" id="filter-form" role="search">
<div class="filter-search"><label for="search">Rechercher dans les publications</label><input type="search" id="search" name="q" autocomplete="off" placeholder="Titre, thème, mot-clé…"/></div>
<div class="filter-grid">
<div><label for="cycle">Là où ça se joue</label><select id="cycle" name="cycle"><option value="">Tous les secteurs</option>{cycleCatalogue.map(item=><option value={item.code}>{item.label}</option>)}</select></div>
<div><label for="conversation">Les sujets qui fâchent</label><select id="conversation" name="conversation"><option value="">Tous les sujets</option></select></div>
<div><label for="contexte">Contexte</label><select id="contexte" name="contexte"><option value="">Tous les contextes</option></select></div>
<div><label for="genre">Les formats</label><select id="genre" name="genre"><option value="">Tous les formats</option><option value="grand-entretien">Grands Entretiens</option><option value="chronique">Comédies économiques</option><option value="regard-croise">Le fond du problème</option></select></div>
<div><label for="lecture">Les angles morts</label><select id="lecture" name="lecture"><option value="">Tous les angles morts</option>{Object.entries(publicPerspectives).map(([key,value])=><option value={key}>{value.label}</option>)}</select></div>
</div><div class="filter-actions"><button type="reset">Effacer les filtres</button><p id="result-count" aria-live="polite">{entries.length} publication(s)</p></div>
</form>
<div id="catalogue-results" class="catalogue-results">
{entries.map(a=><article class={`catalogue-result editorial-image-${a.taille_image_liste==="grande"?"large":a.taille_image_liste==="moyenne"?"medium":a.taille_image_liste==="vignette"?"thumb":"none"}`} data-cycle={a.cycle} data-conversation={a.conversation} data-contexte={a.contexte} data-lecture={a.lecture} data-genre={a.genre} data-search={[a.title,a.summary,a.tags,a.conversationLabel,a.contextLabel,a.lectureLabel,a.lectureTechnical,a.formatLabel].join(' ').toLocaleLowerCase('fr-FR')}>
{a.hero_image&&a.taille_image_liste!=="sans"&&a.taille_image_liste!=="automatique"&&<img class="article-list-photo" src={a.hero_image} alt="" loading="lazy"/>}<p class="micro">{a.formatLabel} · {a.conversationLabel} · {a.lectureLabel || 'Analyse journalistique'}</p>
<h2><a href={a.url}>{a.title}</a></h2><p>{a.summary}</p></article>)}
</div><p id="no-results" hidden>Aucune publication ne correspond à ces critères. Essayez d’élargir votre recherche.</p>
</main>
<script define:vars={{ conversationOptions:conversationFilterOptions, contextOptions:contextFilterOptions }}>
const form=document.querySelector('#filter-form');
const search=document.querySelector('#search');
const cycle=document.querySelector('#cycle');
const conversation=document.querySelector('#conversation');
const contexte=document.querySelector('#contexte');
const lecture=document.querySelector('#lecture');
const genre=document.querySelector('#genre');
const rows=[...document.querySelectorAll('.catalogue-result')];
const count=document.querySelector('#result-count');
const none=document.querySelector('#no-results');
const normalize=(v)=>String(v??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('fr-FR').trim();
function fill(select,choices,prompt){
 const previous=select.value;select.replaceChildren(new Option(prompt,''));
 Object.entries(choices).forEach(([key,value])=>select.add(new Option(value,key)));
 if([...select.options].some(o=>o.value===previous)) select.value=previous;
}
function redraw(){
 const c=cycle.value;
 const choiceConversations=c?(conversationOptions[c]??{}):Object.assign({},...Object.values(conversationOptions).map(x=>x));
 const choiceContexts=c?(contextOptions[c]??{}):Object.fromEntries(Object.entries(contextOptions).flatMap(([key,values])=>Object.entries(values).map(([id,label])=>[key+':'+id,label+' ('+key+')'])));
 fill(conversation,choiceConversations,'Tous les sujets');
 fill(contexte,choiceContexts,'Tous les contextes');
 const term=normalize(search.value);
 let shown=0;
 rows.forEach(row=>{
 const matchesConversation=!conversation.value||row.dataset.conversation===conversation.value;
 const contextKey=c?contexte.value:contexte.value.split(':').slice(1).join(':');
 const matchesContext=!contexte.value||row.dataset.contexte===contextKey&&(!contexte.value.includes(':')||row.dataset.cycle===contexte.value.split(':')[0]);
 const matches=(!c||row.dataset.cycle===c)&&matchesConversation&&matchesContext&&(!lecture.value||row.dataset.lecture===lecture.value)&&(!genre.value||row.dataset.genre===genre.value)&&(!term||normalize(row.dataset.search).includes(term));
 row.hidden=!matches;if(matches)shown++;
 });
 count.textContent=shown+' publication(s)';none.hidden=shown!==0;
 const params=new URLSearchParams();
 for(const el of [search,cycle,conversation,contexte,lecture,genre])if(el.value)params.set(el.name,el.value);
 history.replaceState(null,'',location.pathname+(params.size?'?'+params:''));
}
const initial=new URLSearchParams(location.search);
if(initial.get('cycle'))cycle.value=initial.get('cycle');
const startingCycle=cycle.value;
fill(conversation,startingCycle?(conversationOptions[startingCycle]??{}):Object.assign({},...Object.values(conversationOptions).map(x=>x)),'Tous les sujets');
fill(contexte,startingCycle?(contextOptions[startingCycle]??{}):Object.fromEntries(Object.entries(contextOptions).flatMap(([key,values])=>Object.entries(values).map(([id,label])=>[key+':'+id,label+' ('+key+')']))),'Tous les contextes');
for(const el of [search,conversation,contexte,lecture,genre])if(initial.has(el.name))el.value=initial.get(el.name);
form.addEventListener('input',redraw);
form.addEventListener('change',redraw);
form.addEventListener('reset',()=>{requestAnimationFrame(redraw)});
redraw();
</script><MediaFooter/></body></html>