---
import { getCollection, render } from 'astro:content';
import { isPublic, validClassification, urlOf, conversations, contexts, readings, formattedDate, publicationInstant, perspectiveOf, genreOf, narrativeGenres } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
import { absolutePageUrl, robotsDirective } from '../../../lib/seo';
export async function getStaticPaths(){
 const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data));
 return items.map(article=>({params:{id:article.id},props:{article,items}}));
}
const {article,items}=Astro.props;
const d=article.data;
const {Content}=await render(article);
const classification=conversations[d.cycle]?.[d.conversation] ?? d.conversation;
const context=contexts[d.cycle]?.[d.contexte] ?? d.contexte;
const perspectiveCode=perspectiveOf(d);
const reading=readings[perspectiveCode] ?? perspectiveCode;
const genre=genreOf(d);
const genreLabel=genre ? narrativeGenres[genre] : null;
// V6 : signatures exclusives par genre ; les Chroniques restent attribuées au cas par cas.
const authorSignature = d.format === 'regard-croise' ? d.signature_auteur : genre === 'grand-entretien' ? 'Jean Toksic' : genre === 'recit' ? 'Oscar Sauvage' : (genre === 'chronique' ? d.signature_auteur : null);
const formatNames={'entretien':'Scène — fiction économique documentée','regard-croise':'Regard croisé','analyse-sectorielle':'Analyse sectorielle','decouverte':'Article de découverte'};
const format=(formatNames as Record<string,string>)[d.format??'']??(genreLabel ? null : d.format);
const pubDate=publicationInstant(d.publication_date);
const updated=d.updated_date ? publicationInstant(d.updated_date) : null;
const interview=d.interview_date ? publicationInstant(d.interview_date) : null;
const tags=[d.tag_1,d.tag_2,d.tag_3,d.tag_4,d.tag_5].filter((v):v is string=>typeof v==='string'&&v.trim().length>0).map(v=>v.trim());
const p=d.source_profile ?? {};
const organization=p.organisation_type;
const profileRows=[['Fonction',p.fonction],['Type d’organisation',organization],['Domaine d’activité',p.domaine],['Responsabilités et périmètre d’expérience',p.responsabilites_perimetre],['Position dans l’arbitrage',p.role_arbitrage],['Expérience professionnelle',p.experience]].filter(([,value])=>typeof value==='string' && value.trim());
const summaryProfile=typeof d.source_notice==='string'&&d.source_notice.trim()?d.source_notice.trim():null;
// Cinq familles distinctes de recommandations, sans doublons d'articles.
const ordered=items.filter(a=>a.id!==article.id).sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const consumed=new Set<string>();
const take=(predicate:(a:typeof ordered[number])=>boolean,limit=3)=>{
 const selection=ordered.filter(a=>!consumed.has(a.id)&&predicate(a)).slice(0,limit);
 selection.forEach(a=>consumed.add(a.id));
 return selection;
};
const recommendations=[
 {key:'lectures',title:'Dans cette conversation',entries:take(a=>a.data.cycle===d.cycle&&a.data.conversation===d.conversation&&a.data.contexte===d.contexte&&perspectiveOf(a.data)!==perspectiveCode,4)},
 {key:'contextes',title:'La conversation dans d’autres contextes',entries:take(a=>a.data.cycle===d.cycle&&a.data.conversation===d.conversation&&a.data.contexte!==d.contexte)},
 {key:'cycle',title:'Dans la même rubrique',entries:take(a=>a.data.cycle===d.cycle&&a.data.conversation!==d.conversation)},
 {key:'transversal',title:'Sur le même sujet',entries:take(a=>a.data.cycle!==d.cycle&&perspectiveOf(a.data)===perspectiveCode)},
 {key:'recent',title:'À lire aussi',entries:take(()=>true,3)},
].filter(group=>group.entries.length>0);
const seoTitle=typeof d.seo?.seo_title==='string'&&d.seo.seo_title.trim()?d.seo.seo_title:d.title;
const seoDescription=typeof d.seo?.seo_description==='string'&&d.seo.seo_description.trim()?d.seo.seo_description:(d.summary??'');
const imageAlt=typeof d.seo?.image_alt==='string'?d.seo.image_alt:'';
const imageSocial=typeof d.seo?.social_image==='string'?d.seo.social_image:d.hero_image;
const canonical=absolutePageUrl(urlOf(article.id));
const articleStructuredData={ '@context':'https://schema.org', '@type':'Article', headline:d.title, description:seoDescription, datePublished:pubDate?.toISOString(), dateModified:(updated??pubDate)?.toISOString(), inLanguage:'fr-FR', mainEntityOfPage:canonical, publisher:{'@type':'Organization',name:'Scènes d’Arbitrage'}, ...(d.hero_image?{image:[absolutePageUrl(d.hero_image)]}:{}) };
const shareBase=canonical;
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content={robotsDirective}/><link rel="canonical" href={canonical}/><title>{seoTitle} — Scènes d’Arbitrage</title><meta name="description" content={seoDescription}/>
<script type="application/ld+json" set:html={JSON.stringify(articleStructuredData).replace(/</g,"\\u003c")}/><meta property="og:title" content={seoTitle}/><meta property="og:description" content={seoDescription}/><meta property="og:type" content="article"/><meta property="og:url" content={canonical}/>
{imageSocial&&<meta property="og:image" content={imageSocial}/>}<meta name="twitter:card" content={imageSocial?'summary_large_image':'summary'}/>
{pubDate&&<meta property="article:published_time" content={pubDate.toISOString()}/>} {updated&&<meta property="article:modified_time" content={updated.toISOString()}/>}<style is:inline set:html={articleStyle}/>

<style is:inline>
/* Minimal editorial reading tools: no panels until explicitly opened. */
.reader-toolbar{display:flex;align-items:flex-start;gap:1.25rem;margin:1rem 0 .6rem;padding:.55rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font:500 13px/1.4 'IBM Plex Sans',Arial,sans-serif}
.reader-tool{position:relative;min-width:0}
.reader-tool>summary{display:inline-flex;align-items:center;gap:.45rem;cursor:pointer;list-style:none;color:var(--ink);padding:.45rem .15rem;min-height:2.25rem}
.reader-tool>summary::-webkit-details-marker{display:none}
.reader-tool>summary span{font-size:18px;color:var(--blue);line-height:1}
.reader-tool>summary:hover,.reader-tool[open]>summary{color:var(--blue)}
.reader-tool>summary:focus-visible{outline:2px solid var(--blue);outline-offset:3px}
.reader-tool .tool-panel{position:absolute;top:100%;left:0;z-index:5;width:min(355px,calc(100vw - 44px));padding:15px;background:#fff;border:1px solid var(--line);box-shadow:0 6px 18px rgba(10,25,40,.11)}
.reader-tool.share-tool .tool-panel{width:min(330px,calc(100vw - 44px))}
.reader-tool .audio-description{margin:0 0 10px;font-size:12px;line-height:1.5}
.reader-tool .audio-controls{gap:5px}
.reader-tool .audio-controls button{font-size:12px;padding:7px 9px;min-height:34px}
.reader-tool .audio-status{margin:9px 0 0;font-size:11px}
.share-links{display:flex;flex-wrap:wrap;gap:6px}
.share-links a,.share-links button{border:1px solid var(--line);background:#fff;color:var(--blue);font:500 12px/1.3 'IBM Plex Sans',Arial,sans-serif;padding:8px 10px;cursor:pointer;text-decoration:none}
.share-links a:hover,.share-links button:hover{background:#f3f7fb}
@media(max-width:480px){.reader-toolbar{gap:1rem}.reader-tool.share-tool .tool-panel{left:auto;right:0}}
</style></head><body><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main class="shell" id="contenu"><div class="reading">

<header><p class="kicker"><a href={`/media/cycles/${d.cycle}/`}>{d.cycle}</a> / <a href={`/media/cycles/${d.cycle}/conversations/${d.conversation}/`}>{classification}</a> / <a href={`/media/cycles/${d.cycle}/contextes/${d.contexte}/`}>{context}</a></p><h1>{d.title}</h1>{d.summary&&<p class="lead">{d.summary}</p>}
<div class="meta">{format&&<span>{format}</span>}{genreLabel&&<span>{genreLabel}</span>}<a href={`/media/lectures/${perspectiveCode}/`}>Perspective : {reading}</a>{pubDate&&<span>Publié le {formattedDate(pubDate)}</span>}{updated&&<span>Mis à jour le {formattedDate(updated)}</span>}</div></header>
{d.hero_image&&<img class="hero" src={d.hero_image} alt={imageAlt} loading="eager"/>}
<div class="reader-toolbar" aria-label="Outils de lecture"><details class="reader-tool" id="audio-reader"><summary aria-label="Ouvrir la lecture audio"><span aria-hidden="true">♫</span> Écouter</summary><div class="tool-panel"><p class="audio-description">Lecture vocale avec la voix française disponible sur votre appareil.</p><div class="audio-controls"><button type="button" id="audio-play">Écouter</button><button type="button" id="audio-pause" disabled>Pause</button><button type="button" id="audio-resume" disabled>Reprendre</button><button type="button" id="audio-stop" disabled>Arrêter</button></div><p class="audio-status" id="audio-status" role="status" aria-live="polite">Prêt à écouter.</p></div></details><details class="reader-tool share-tool"><summary aria-label="Afficher les options de partage"><span aria-hidden="true">↗</span> Partager</summary><div class="tool-panel"><div class="share-links" aria-label="Options de partage"><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareBase)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareBase)}`} target="_blank" rel="noopener noreferrer">Facebook</a><a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareBase)}&text=${encodeURIComponent(d.title)}`} target="_blank" rel="noopener noreferrer">X</a><a href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(shareBase)}`}>E-mail</a><button id="copy-article-link" type="button">Copier le lien</button></div></div></details></div><article class="article" aria-label="Texte intégral"><Content/></article>

{authorSignature&&<section class="panel" aria-label="Signature de l’auteur"><p class="micro">SIGNATURE</p>{d.signature_portrait&&<img src={d.signature_portrait} alt="" loading="lazy" style="max-width:96px;border-radius:50%"/>}<h2>{authorSignature}</h2>{d.signature_biographie&&<p>{d.signature_biographie}</p>}{d.signature_tonalite&&<p class="small">Tonalité : {d.signature_tonalite}</p>}</section>}
{(summaryProfile||profileRows.length>0)&&<section class="panel" aria-labelledby="source-title"><p class="micro">{d.format==='regard-croise'?'NOTICE DOCUMENTAIRE':'FICTION ÉCONOMIQUE'}</p><h2 id="source-title">{d.format==='regard-croise'?'À propos de cette analyse':'À propos de cette Scène'}</h2>{summaryProfile&&<p>{summaryProfile}</p>}{profileRows.length>0&&<dl class="source-facts">{profileRows.map(([label,value])=><><dt>{label}</dt><dd>{value}</dd></>)}</dl>}</section>}

{tags.length>0&&<section class="panel article-topics" aria-labelledby="tags-title"><p class="micro" id="tags-title">SUJETS ASSOCIÉS</p><div class="chips">{tags.map(t=><span class="chip">{t}</span>)}</div></section>}
{recommendations.length>0&&<aside class="recommendations" aria-label="À lire également">{recommendations.map(group=><section class="recommendation-group" aria-labelledby={`rec-${group.key}`}><h2 id={`rec-${group.key}`}>{group.title}</h2><div class="recommendation-links">{group.entries.map(a=><a href={urlOf(a.id)} class="recommendation-card"><span class="micro">{a.data.cycle} · {readings[a.data.lecture_principale]}</span><strong>{a.data.title}</strong></a>)}</div></section>)}</aside>}
<section class="panel" aria-labelledby="conversations-title"><h2 id="conversations-title">Toute la rubrique {d.cycle==='industrie'?'Industrie':'Immobilier'}</h2><p><a href={`/media/cycles/${d.cycle}/`}>Découvrir les conversations et les contextes</a></p></section>
</div></main><script is:inline>document.getElementById('copy-article-link')?.addEventListener('click',async function(){try{await navigator.clipboard.writeText(location.href);this.textContent='Lien copié';}catch{this.textContent='Copiez l’adresse du navigateur';}});</script><script is:inline>
(function(){
 const root=document.getElementById('audio-reader');
 const content=document.querySelector('article.article');
 const status=document.getElementById('audio-status');
 const play=document.getElementById('audio-play'),pause=document.getElementById('audio-pause'),resume=document.getElementById('audio-resume'),stop=document.getElementById('audio-stop');
 if(!root||!content||!window.speechSynthesis||!window.SpeechSynthesisUtterance){if(root){root.querySelector('.audio-controls').hidden=true;status.textContent='La lecture vocale n’est pas disponible dans ce navigateur.';}return;}
 const synth=window.speechSynthesis;
 let active=null;
 function buttons(state){play.disabled=state==='playing'||state==='paused';pause.disabled=state!=='playing';resume.disabled=state!=='paused';stop.disabled=state==='idle';}
 function halt(){synth.cancel();active=null;buttons('idle');status.textContent='Lecture arrêtée.';}
 play.addEventListener('click',()=>{
  synth.cancel();
  const text=content.innerText?.trim();
  if(!text){status.textContent='Aucun texte à lire.';return;}
  const utterance=new SpeechSynthesisUtterance(text);
  utterance.lang='fr-FR';utterance.rate=1;utterance.pitch=1;
  const voices=synth.getVoices();utterance.voice=voices.find(v=>v.lang.toLowerCase()==='fr-fr')||voices.find(v=>v.lang.toLowerCase().startsWith('fr'))||null;
  active=utterance;
  utterance.onend=()=>{if(active===utterance){active=null;buttons('idle');status.textContent='Lecture terminée.';}};
  utterance.onerror=(e)=>{if(active===utterance){active=null;buttons('idle');status.textContent=e.error==='canceled'?'Lecture arrêtée.':'Lecture indisponible sur cet appareil.';}};
  buttons('playing');status.textContent='Lecture en cours.';synth.speak(utterance);
 });
 pause.addEventListener('click',()=>{if(active&&!synth.paused){synth.pause();buttons('paused');status.textContent='Lecture en pause.';}});
 resume.addEventListener('click',()=>{if(active&&synth.paused){synth.resume();buttons('playing');status.textContent='Lecture reprise.';}});
 stop.addEventListener('click',halt);
 window.addEventListener('pagehide',()=>synth.cancel());
 buttons('idle');
})();
</script><section class="contribute-callout"><p class="micro">SUGGÉRER UNE PISTE ÉDITORIALE</p><h2>Une question ou une source à nous signaler ?</h2><p>Proposez une question économique, une référence documentaire ou un mécanisme à explorer. Les Scènes demeurent des fictions ; les Regards croisés reposent sur des sources réelles.</p><a href={`/media/proposer-un-eclairage/?cycle=${encodeURIComponent(d.cycle)}&conversation=${encodeURIComponent(d.conversation)}`}>Contribuer</a></section>
<MediaFooter/>
{d.format==='entretien'&&<script is:inline>
(function(){
 const root=document.querySelector('article.article');if(!root)return;
 const intro=(root.textContent||'').match(/(?:Je m.appelle|Moi, c.est|Je suis)\s+([A-ZÀ-ÖØ-Ý][a-zà-öø-ÿ-]+)/i);
 const name=intro?.[1]||'Interlocuteur';
 let turn=0;
 // Some approved manuscripts use unprefixed alternating dialogue rather than em dashes.
 // Begin only at an explicit journalist introduction; leave narrative paragraphs untouched.
 const paragraphs=Array.from(root.querySelectorAll('p'));
 const plainStart=paragraphs.findIndex(p=>/^\s*Scènes d.Arbitrage\s*[—–-]\s*/i.test(p.textContent||''));
 if(plainStart>=0){
  paragraphs.slice(plainStart).forEach((p,i)=>{
   if(p.closest('section,aside,blockquote')||p.querySelector('a, img, code'))return;
   const isQuestion=i%2===0;
   const div=document.createElement('div');
   div.className='interview-turn '+(isQuestion?'interview-question':'interview-answer');
   const label=document.createElement('span');
   label.className='interview-speaker';
   label.textContent=isQuestion?'Journaliste':name;
   const words=document.createElement('div');
   words.className='interview-words';
   words.innerHTML=p.innerHTML.replace(/^\s*Scènes d.Arbitrage\s*[—–-]\s*/i,'').replace(new RegExp('^\\s*'+name+'\\s*[—–-]\\s*','i'),'');
   div.append(label,words);
   p.replaceWith(div);
  });
  return;
 }
 root.querySelectorAll('p').forEach(p=>{
  const html=p.innerHTML;
  if(!/^\s*[—–-]\s/.test(p.textContent||''))return;
  const pieces=html.split(/<br\s*\/?\s*>/i).map(x=>x.trim()).filter(Boolean);
  if(!pieces.length||!pieces.every(x=>/^\s*[—–-]\s/.test(x.replace(/<[^>]*>/g,''))))return;
  const fragment=document.createDocumentFragment();
  pieces.forEach(part=>{
   const speaker=turn%2===0?'Journaliste':name;
   const div=document.createElement('div');div.className='interview-turn '+(turn%2===0?'interview-question':'interview-answer');
   const label=document.createElement('span');label.className='interview-speaker';label.textContent=speaker;
   const body=document.createElement('div');body.className='interview-words';body.innerHTML=part.replace(/^\s*[—–-]\s*/, '');
   div.append(label,body);fragment.append(div);turn++;
  });
  p.replaceWith(fragment);
 });
})();
</script>}
</body></html>
