---
import { getCollection, render } from 'astro:content';
import { isPublic, validClassification, urlOf, conversations, contexts, readings, formattedDate, publicationInstant } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaFooter from '../../../components/MediaFooter.astro';
import { absolutePageUrl, robotsDirective } from '../../../lib/seo';
export async function getStaticPaths(){
 const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data));
 return items.map(article=>({params:{id:article.id},props:{article,items}}));
}
const {article,items}=Astro.props;
const d=article.data;
const {Content}=await render(article);
const classification=conversations[d.cycle]?.[d.conversation] ?? d.conversation;
const context=contexts[d.cycle]?.[d.contexte] ?? d.contexte;
const reading=readings[d.lecture_principale] ?? d.lecture_principale;
const formatNames={'entretien':'Entretien','regard-croise':'Regard croisé','analyse-sectorielle':'Analyse sectorielle','decouverte':'Article de découverte'};
const format=(formatNames as Record<string,string>)[d.format??'']??d.format;
const pubDate=publicationInstant(d.publication_date);
const updated=d.updated_date ? publicationInstant(d.updated_date) : null;
const interview=d.interview_date ? publicationInstant(d.interview_date) : null;
const tags=[d.tag_1,d.tag_2,d.tag_3,d.tag_4,d.tag_5].filter((v):v is string=>typeof v==='string'&&v.trim().length>0).map(v=>v.trim());
const p=d.source_profile ?? {};
const organization=p.organisation_type;
const profileRows=[['Fonction',p.fonction],['Type d’organisation',organization],['Domaine d’activité',p.domaine],['Responsabilités et périmètre d’expérience',p.responsabilites_perimetre],['Position dans l’arbitrage',p.role_arbitrage],['Expérience professionnelle',p.experience]].filter(([,value])=>typeof value==='string' && value.trim());
const summaryProfile=typeof d.source_notice==='string'&&d.source_notice.trim()?d.source_notice.trim():null;
// Cinq familles distinctes de recommandations, sans doublons d'articles.
const ordered=items.filter(a=>a.id!==article.id).sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const consumed=new Set<string>();
const take=(predicate:(a:typeof ordered[number])=>boolean,limit=3)=>{
 const selection=ordered.filter(a=>!consumed.has(a.id)&&predicate(a)).slice(0,limit);
 selection.forEach(a=>consumed.add(a.id));
 return selection;
};
const recommendations=[
 {key:'contextes',eyebrow:'COMPARER LES SITUATIONS',title:'Cette conversation dans d’autres contextes',description:'Retrouvez les décisions éclairées par d’autres situations.',entries:take(a=>a.data.cycle===d.cycle&&a.data.conversation===d.conversation&&a.data.contexte!==d.contexte)},
 {key:'lectures',eyebrow:'CROISER LES REGARDS',title:'Cette conversation sous d’autres lectures',description:'Une même conversation, d’autres expertises professionnelles.',entries:take(a=>a.data.cycle===d.cycle&&a.data.conversation===d.conversation&&a.data.lecture_principale!==d.lecture_principale)},
 {key:'cycle',eyebrow:'ÉLARGIR LE SUJET',title:'D’autres conversations de ce cycle',description:'Explorez les autres arbitrages du secteur.',entries:take(a=>a.data.cycle===d.cycle&&a.data.conversation!==d.conversation)},
 {key:'transversal',eyebrow:'TRAVERSER LES SECTEURS',title:'Cette lecture dans d’autres cycles',description:'La même expertise appliquée à d’autres activités économiques.',entries:take(a=>a.data.cycle!==d.cycle&&a.data.lecture_principale===d.lecture_principale)},
 {key:'recent',eyebrow:'POURSUIVRE LA LECTURE',title:'Autres publications récentes',description:'D’autres analyses sélectionnées parmi les dernières publications.',entries:take(()=>true,4)},
].filter(group=>group.entries.length>0);
const seoTitle=typeof d.seo?.seo_title==='string'&&d.seo.seo_title.trim()?d.seo.seo_title:d.title;
const seoDescription=typeof d.seo?.seo_description==='string'&&d.seo.seo_description.trim()?d.seo.seo_description:(d.summary??'');
const imageAlt=typeof d.seo?.image_alt==='string'?d.seo.image_alt:'';
const imageSocial=typeof d.seo?.social_image==='string'?d.seo.social_image:d.hero_image;
const canonical=absolutePageUrl(urlOf(article.id));
const articleStructuredData={ '@context':'https://schema.org', '@type':'Article', headline:d.title, description:seoDescription, datePublished:pubDate?.toISOString(), dateModified:(updated??pubDate)?.toISOString(), inLanguage:'fr-FR', mainEntityOfPage:canonical, publisher:{'@type':'Organization',name:'Scènes d’Arbitrage'}, ...(d.hero_image?{image:[absolutePageUrl(d.hero_image)]}:{}) };
const shareBase=canonical;
const sourceMethod='Scènes d’Arbitrage privilégie les prises de contact à l’initiative de sa rédaction. Pour les entretiens réels, la rédaction vérifie l’identité et les responsabilités de ses sources ainsi que leur proximité avec les arbitrages décrits. Certaines caractéristiques peuvent être généralisées pour protéger les personnes interrogées. Cette notice générale ne constitue pas une attestation des vérifications propres à chaque article.';
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content={robotsDirective}/><link rel="canonical" href={canonical}/><title>{seoTitle} — Scènes d’Arbitrage</title><meta name="description" content={seoDescription}/>
<script type="application/ld+json" set:html={JSON.stringify(articleStructuredData).replace(/</g,"\\u003c")}/><meta property="og:title" content={seoTitle}/><meta property="og:description" content={seoDescription}/><meta property="og:type" content="article"/><meta property="og:url" content={canonical}/>
{imageSocial&&<meta property="og:image" content={imageSocial}/>}<meta name="twitter:card" content={imageSocial?'summary_large_image':'summary'}/>
{pubDate&&<meta property="article:published_time" content={pubDate.toISOString()}/>} {updated&&<meta property="article:modified_time" content={updated.toISOString()}/>}<style is:inline set:html={articleStyle}/>
</head><body><a class="skip" href="#contenu">Aller au contenu</a><div class="site-bar"><nav class="site-bar-inner"><a class="brand" href="/media/">SCÈNES D’ARBITRAGE</a><span class="site-label">PROTOTYPE — PRÉPRODUCTION</span></nav><nav class="section-nav" aria-label="Rubriques"><a href="/media/">Accueil</a><a href="/media/cycles/industrie/">Industrie</a><a href="/media/cycles/immobilier/">Immobilier</a><a href="/media/#lectures">Lectures</a><a href="/media/publications/">Publications</a><a href="/media/newsletter/">Newsletter</a></nav></div><main class="shell" id="contenu"><div class="reading">

<header><p class="kicker"><a href={`/media/cycles/${d.cycle}/`}>{d.cycle}</a> / <a href={`/media/cycles/${d.cycle}/conversations/${d.conversation}/`}>{classification}</a> / <a href={`/media/cycles/${d.cycle}/contextes/${d.contexte}/`}>{context}</a></p><h1>{d.title}</h1>{d.summary&&<p class="lead">{d.summary}</p>}
<div class="meta">{format&&<span>{format}</span>}<a href={`/media/lectures/${d.lecture_principale}/`}>{reading}</a>{pubDate&&<span>Publié le {formattedDate(pubDate)}</span>}{updated&&<span>Mis à jour le {formattedDate(updated)}</span>}{interview&&<span>Entretien réalisé le {formattedDate(interview)}</span>}</div></header>
{d.hero_image&&<img class="hero" src={d.hero_image} alt={imageAlt} loading="eager"/>}
<div class="action-bar" aria-label="Partager l’article"><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareBase)}`} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareBase)}`} target="_blank" rel="noopener noreferrer">Facebook</a><a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(shareBase)}&text=${encodeURIComponent(d.title)}`} target="_blank" rel="noopener noreferrer">X</a><a href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(shareBase)}`}>E-mail</a><button id="copy-article-link" type="button">Copier le lien</button></div><section class="audio-reader" id="audio-reader" aria-label="Lecture vocale de l’article"><div><p class="micro">ÉCOUTER L’ARTICLE</p><p class="audio-description">Lecture vocale en français avec la voix disponible sur votre appareil.</p></div><div class="audio-controls"><button type="button" id="audio-play">Écouter</button><button type="button" id="audio-pause" disabled>Pause</button><button type="button" id="audio-resume" disabled>Reprendre</button><button type="button" id="audio-stop" disabled>Arrêter</button></div><p class="audio-status" id="audio-status" role="status" aria-live="polite">Prêt à écouter.</p></section><article class="article" aria-label="Texte intégral"><Content/></article>
{(summaryProfile||profileRows.length>0)&&<section class="panel" aria-labelledby="source-title"><p class="micro">PROFIL ANONYMISÉ</p><h2 id="source-title">Notre interlocuteur</h2>{summaryProfile&&<p>{summaryProfile}</p>}{profileRows.length>0&&<dl class="source-facts">{profileRows.map(([label,value])=><><dt>{label}</dt><dd>{value}</dd></>)}</dl>}</section>}
<section class="panel" aria-labelledby="methode-title"><p class="micro">TRANSPARENCE JOURNALISTIQUE</p><h2 id="methode-title">Notre méthode</h2><p>{sourceMethod}</p>{d.methodology_specific&&<p><strong>Précisions propres à cet article :</strong> {d.methodology_specific}</p>}</section>
{tags.length>0&&<section class="panel" aria-labelledby="tags-title"><h2 id="tags-title">Mots-clés</h2><div class="chips">{tags.map(t=><span class="chip">{t}</span>)}</div></section>}
{recommendations.length>0&&<aside class="recommendations" aria-label="Pour poursuivre votre lecture"><p class="micro">POUR ALLER PLUS LOIN</p><h2>Continuer à explorer</h2>{recommendations.map(group=><section class="recommendation-group" aria-labelledby={`rec-${group.key}`}><p class="micro">{group.eyebrow}</p><h3 id={`rec-${group.key}`}>{group.title}</h3><p class="small">{group.description}</p><div class="recommendation-links">{group.entries.map(a=><a href={urlOf(a.id)} class="recommendation-card"><span class="micro">{a.data.cycle} · {conversations[a.data.cycle]?.[a.data.conversation]} · {readings[a.data.lecture_principale]}</span><strong>{a.data.title}</strong></a>)}</div></section>)}</aside>}
<section class="panel" aria-labelledby="conversations-title"><h2 id="conversations-title">Explorer le cycle {d.cycle==='industrie'?'Industrie':'Immobilier'}</h2><p><a href={`/media/cycles/${d.cycle}/`}>Voir les sept conversations et les trois contextes</a></p><p><a href="/media/publications/">Rechercher dans toutes les publications</a></p></section>
</div></main><script is:inline>document.getElementById('copy-article-link')?.addEventListener('click',async function(){try{await navigator.clipboard.writeText(location.href);this.textContent='Lien copié';}catch{this.textContent='Copiez l’adresse du navigateur';}});</script><script is:inline>
(function(){
 const root=document.getElementById('audio-reader');
 const content=document.querySelector('article.article');
 const status=document.getElementById('audio-status');
 const play=document.getElementById('audio-play'),pause=document.getElementById('audio-pause'),resume=document.getElementById('audio-resume'),stop=document.getElementById('audio-stop');
 if(!root||!content||!window.speechSynthesis||!window.SpeechSynthesisUtterance){if(root){root.querySelector('.audio-controls').hidden=true;status.textContent='La lecture vocale n’est pas disponible dans ce navigateur.';}return;}
 const synth=window.speechSynthesis;
 let active=null;
 function buttons(state){play.disabled=state==='playing'||state==='paused';pause.disabled=state!=='playing';resume.disabled=state!=='paused';stop.disabled=state==='idle';}
 function halt(){synth.cancel();active=null;buttons('idle');status.textContent='Lecture arrêtée.';}
 play.addEventListener('click',()=>{
  synth.cancel();
  const text=content.innerText?.trim();
  if(!text){status.textContent='Aucun texte à lire.';return;}
  const utterance=new SpeechSynthesisUtterance(text);
  utterance.lang='fr-FR';utterance.rate=1;utterance.pitch=1;
  const voices=synth.getVoices();utterance.voice=voices.find(v=>v.lang.toLowerCase()==='fr-fr')||voices.find(v=>v.lang.toLowerCase().startsWith('fr'))||null;
  active=utterance;
  utterance.onend=()=>{if(active===utterance){active=null;buttons('idle');status.textContent='Lecture terminée.';}};
  utterance.onerror=(e)=>{if(active===utterance){active=null;buttons('idle');status.textContent=e.error==='canceled'?'Lecture arrêtée.':'Lecture indisponible sur cet appareil.';}};
  buttons('playing');status.textContent='Lecture en cours.';synth.speak(utterance);
 });
 pause.addEventListener('click',()=>{if(active&&!synth.paused){synth.pause();buttons('paused');status.textContent='Lecture en pause.';}});
 resume.addEventListener('click',()=>{if(active&&synth.paused){synth.resume();buttons('playing');status.textContent='Lecture reprise.';}});
 stop.addEventListener('click',halt);
 window.addEventListener('pagehide',()=>synth.cancel());
 buttons('idle');
})();
</script><section class="contribute-callout"><p class="micro">PARTAGER UNE EXPÉRIENCE</p><h2>Vous avez un éclairage sur ce sujet ?</h2><p>Votre expérience professionnelle peut contribuer à une conversation. La rédaction examine les propositions et prend contact si un échange est pertinent.</p><a href={`/media/proposer-un-eclairage/?cycle=${encodeURIComponent(d.cycle)}&conversation=${encodeURIComponent(d.conversation)}`}>Proposer un éclairage</a></section>
<MediaFooter/></body></html>
