---
import { articleStyle } from '../../../lib/article-style';
const pages={
 'qui-sommes-nous':{
  nav:'Qui sommes-nous ?', eyebrow:'LE MÉDIA',title:'Comprendre les décisions qui façonnent l’économie.',
  intro:'Scènes d’Arbitrage est un média consacré aux décisions économiques réelles, racontées depuis l’expérience de celles et ceux qui les préparent, les prennent ou les mettent en œuvre.',
  sections:[
   {title:'Pourquoi ce média ?',paragraphs:['Une décision économique n’a pas une seule lecture. Elle peut engager à la fois une stratégie, un financement, un cadre juridique, des ressources, un outil de production ou un territoire. Chacun en perçoit une part. Les mettre en regard permet de comprendre ce qui oriente réellement les choix.','Notre ambition est de rendre lisible cette intelligence de situation, sans réduire les trajectoires économiques à des annonces, à des résultats ou à des prises de position générales.']},
   {title:'Des conversations structurées, des regards complémentaires',paragraphs:['Chaque cycle rassemble plusieurs conversations autour de questions identifiées. Une même conversation peut être éclairée par différentes situations et plusieurs expertises professionnelles.','Les entretiens écrits, les regards croisés et les analyses sectorielles permettent de passer de l’expérience particulière à une compréhension plus large des décisions.']},
   {title:'Deux premiers terrains d’exploration',paragraphs:['L’Industrie examine les choix qui orientent les capacités productives, l’investissement, les interdépendances et les transformations industrielles.','Le Logement & la fabrique des territoires s’intéresse aux décisions qui rendent possibles, transforment et font évoluer le logement, l’immobilier et les espaces d’activité.','Ces deux cycles inauguraux ouvrent un projet éditorial qui a vocation à explorer d’autres composantes de l’économie réelle.']},
   {title:'Une initiative éditoriale indépendante',paragraphs:['Scènes d’Arbitrage est une initiative éditoriale conçue et portée par Hocine Reguida. La sélection des sujets, des angles et des contributions relève du travail de la rédaction.','Le média n’a pas pour objet de promouvoir une personne, une entreprise ou une organisation : il cherche à rendre une expérience utile à d’autres lecteurs.']}
  ]},
 'ligne-editoriale':{
  nav:'Notre ligne éditoriale',eyebrow:'NOS PRINCIPES',title:'La valeur d’une parole tient à ce qu’elle permet de comprendre.',
  intro:'Nous privilégions les expériences précises, les lectures situées et les contributions capables d’éclairer un arbitrage — plutôt que le prestige d’une fonction ou la visibilité d’une organisation.',
  sections:[
   {title:'Partir de situations concrètes',paragraphs:['Une contribution doit s’ancrer dans une décision vécue, observée, accompagnée ou pilotée. Elle permet d’identifier les conditions d’un choix, ses alternatives, ses points d’appui et les enseignements susceptibles d’intéresser d’autres acteurs.']},
   {title:'Faire dialoguer les expertises',paragraphs:['Stratégie, finance, droit, opérations, organisation, compétences et autres lectures professionnelles ne s’opposent pas par principe : elles révèlent des dimensions différentes d’une même question.','La composition des conversations repose sur la pertinence et la complémentarité des éclairages, sans quota mécanique de métiers.']},
   {title:'Ne pas confondre information et promotion',paragraphs:['Une intervention n’est pas une présentation d’offre, un portrait de prestige ou un espace de communication institutionnelle. La rédaction conserve le choix des angles, des questions, des rapprochements et de la publication.','Le titre d’un intervenant ne suffit pas à justifier un entretien. L’apport éditorial prime sur la notoriété.']},
   {title:'Valoriser le discernement sans dramatiser',paragraphs:['Nous recherchons l’intelligence des décisions, la créativité, les adaptations et les capacités de construction. La formulation des questions n’a pas vocation à mettre en accusation les personnes ni à suggérer artificiellement des situations de crise.','La contradiction et l’examen critique conservent toute leur place, sans sensationnalisme ni complaisance.']},
   {title:'Respecter les personnes et les faits',paragraphs:['Les contributions sont préparées et vérifiées dans la limite des sources disponibles. Les informations qui exposeraient inutilement des personnes, des opérations ou des organisations ne sont pas recherchées pour elles-mêmes.','L’anonymisation est expliquée dans notre méthode. Elle n’exonère pas la rédaction de distinguer les témoignages effectivement recueillis des contenus fictifs ou illustratifs.']}
  ]},
 'notre-methode':{
  nav:'Notre méthode',eyebrow:'FABRICATION ÉDITORIALE',title:'Du vécu professionnel à une lecture utile.',
  intro:'Nos conversations prennent forme par la qualification des sujets, la recherche d’expériences pertinentes, la conduite d’entretiens et la mise en perspective des réponses.',
  sections:[
   {title:'1. Choisir une question à éclairer',paragraphs:['La rédaction définit une conversation, ses contextes pertinents et les lectures professionnelles susceptibles de faire comprendre les décisions en jeu. Un sujet est retenu pour l’intérêt des questions qu’il ouvre, non pour la seule visibilité des acteurs concernés.']},
   {title:'2. Identifier et contacter les personnes',paragraphs:['Nous prenons principalement l’initiative de contacter les personnes dont l’expérience semble correspondre au sujet. Un lecteur peut aussi signaler une situation, une personne ou un éclairage intéressant. Un signalement ne vaut ni sélection ni promesse de publication.']},
   {title:'3. Préparer et conduire l’entretien',paragraphs:['Les questions sont élaborées pour rendre les situations et les arbitrages intelligibles, dans un cadre respectueux des informations confidentielles. Un échange préparatoire permet, lorsque nécessaire, de clarifier le périmètre de l’intervention.','La préparation ne consiste pas à écrire les réponses à la place de l’intervenant.']},
   {title:'4. Vérifier, restituer, mettre en regard',paragraphs:['La rédaction travaille la fidélité des propos, la cohérence des faits et leur présentation. Les lectures complémentaires peuvent ensuite être rapprochées au sein d’une même conversation, d’un cycle ou d’une analyse transversale.','Les contributions peuvent prendre la forme d’entretiens écrits, de regards croisés et d’analyses sectorielles.']},
   {title:'5. Expliquer notre pratique de l’anonymisation',paragraphs:['L’identité et la qualité d’une source réelle sont vérifiées par la rédaction selon les éléments auxquels elle a accès, même lorsqu’elles ne sont pas rendues publiques. Les notices de méthode accompagnant les articles doivent préciser ce qui peut être affirmé sur la provenance et le traitement du témoignage.','Une anonymisation peut supprimer ou généraliser certains éléments identifiants sans dénaturer la portée des décisions exposées. Aucune notice générique ne remplace une vérification propre à chaque entretien.','Un scénario fictif ou un texte de démonstration doit rester explicitement identifié comme tel et ne doit jamais être présenté comme le témoignage réel d’un intervenant.']},
   {title:'Une relation sans obligation de participation',paragraphs:['Une proposition de contribution, une invitation à échanger ou un entretien préparatoire ne garantissent ni la réalisation ni la publication d’un article. La rédaction apprécie la pertinence d’une contribution au regard de l’ensemble éditorial.']}
  ]}
} as const;
export function getStaticPaths(){return Object.keys(pages).map(page=>({params:{page}}));}
const data=pages[Astro.params.page as keyof typeof pages];
---
