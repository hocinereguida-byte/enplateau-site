---
import { articleStyle } from '../../../lib/article-style';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
const pages={
 'qui-sommes-nous':{
  nav:'Qui sommes-nous ?', eyebrow:'LE MÉDIA',title:'Comprendre les décisions qui façonnent l’économie.',
  intro:'Scènes d’Arbitrage est un média économique indépendant, principalement écrit, qui explore l’intelligence derrière les décisions à partir des expériences de ceux qui les préparent, les prennent ou les mettent en œuvre.',
  sections:[
   {title:'Pourquoi ce média ?',paragraphs:['Une décision économique n’a pas une seule lecture. Elle peut engager à la fois une stratégie, un financement, un cadre juridique, des ressources, un outil de production ou un territoire. Chacun en perçoit une part. Les mettre en regard permet de comprendre ce qui oriente réellement les choix.','Notre ambition est de rendre lisibles les raisonnements, les alternatives et les conséquences, sans réduire l’économie aux annonces, aux seuls dirigeants ou aux résultats visibles.']},
   {title:'Des conversations structurées, des regards complémentaires',paragraphs:['Chaque cycle explore de grandes questions économiques à travers un nombre de conversations adapté au secteur. Une conversation réunit des décisions éclairées par différents contextes et regards professionnels ; elle ne correspond pas à un métier ni à un quota d’articles.','Les Scènes de fiction économique documentée et les Regards croisés fondés sur des sources réelles proposent deux manières complémentaires d’explorer et de comprendre les décisions.']},
   {title:'Deux premiers terrains d’exploration',paragraphs:['L’Industrie examine les choix qui orientent les capacités productives, l’investissement, les interdépendances et les transformations industrielles.','Le Logement & la fabrique des territoires s’intéresse aux décisions qui rendent possibles, transforment et font évoluer le logement, l’immobilier et les espaces d’activité.','Ces deux cycles inauguraux ouvrent un projet éditorial qui a vocation à explorer d’autres composantes de l’économie réelle.']},
   {title:'Une initiative éditoriale indépendante',paragraphs:['Scènes d’Arbitrage est une initiative éditoriale conçue et portée par Hocine Reguida. La sélection des sujets, des angles et des contributions relève du travail de la rédaction.','Le média n’a pas pour objet de promouvoir une personne, une entreprise ou une organisation : il cherche à rendre une expérience utile à d’autres lecteurs.']}
  ]},
 'ligne-editoriale':{
  nav:'Notre ligne éditoriale',eyebrow:'NOS PRINCIPES',title:'La valeur d’une parole tient à ce qu’elle permet de comprendre.',
  intro:'L’intelligence des arbitrages est notre sujet : nous privilégions les expériences vécues, les raisonnements vérifiables et les contributions utiles au lecteur plutôt que le prestige des fonctions.',
  sections:[
   {title:'Partir de situations concrètes',paragraphs:['Une contribution doit s’ancrer dans une décision vécue, observée, accompagnée ou pilotée. Investir ou renoncer à investir, transformer ou conserver, croître ou stabiliser : chaque choix peut révéler une intelligence économique. Nous cherchons les conditions, les alternatives effectivement considérées et les enseignements utiles à d’autres acteurs.']},
   {title:'Faire dialoguer les expertises',paragraphs:['Stratégie, finance, droit, opérations, organisation, compétences et autres lectures professionnelles ne s’opposent pas par principe : elles révèlent des dimensions différentes d’une même question.','La composition des conversations repose sur la pertinence et la complémentarité des éclairages, sans quota mécanique de métiers, d’angles ou de publications.']},
   {title:'Ne pas confondre information et promotion',paragraphs:['Une intervention n’est pas une présentation d’offre, un portrait de prestige ou un espace de communication institutionnelle. La rédaction conserve le choix des angles, des questions, des rapprochements et de la publication.','Le titre d’un intervenant ne suffit pas à justifier un entretien. L’apport éditorial prime sur la notoriété.']},
   {title:'Valoriser le discernement sans dramatiser',paragraphs:['Nous recherchons l’intelligence des décisions, la créativité, les adaptations et les capacités de construction. La formulation des questions n’a pas vocation à mettre en accusation les personnes ni à suggérer artificiellement des situations de crise.','La contradiction et l’examen critique conservent toute leur place, sans sensationnalisme ni complaisance.']},
   {title:'Respecter les personnes et les faits',paragraphs:['Les contributions sont préparées et vérifiées dans la limite des sources disponibles. Les informations qui exposeraient inutilement des personnes, des opérations ou des organisations ne sont pas recherchées pour elles-mêmes.','L’anonymisation est expliquée dans notre méthode. Elle n’exonère pas la rédaction de distinguer les témoignages effectivement recueillis des contenus fictifs ou illustratifs.']}
  ]},
 'notre-methode':{
  nav:'Notre méthode',eyebrow:'FABRICATION ÉDITORIALE',title:'Du vécu professionnel à une lecture utile.',
  intro:'Nos conversations prennent forme par la qualification des sujets, la recherche d’expériences pertinentes, la conduite d’entretiens et la mise en perspective des réponses.',
  sections:[
   {title:'1. Choisir une question à éclairer',paragraphs:['La rédaction commence par examiner les mécanismes économiques d’un secteur, puis définit de grandes questions de conversation. Les contextes et les lectures professionnelles sont retenus selon leur pertinence, sans reproduire artificiellement la même structure d’un cycle à l’autre. Les angles d’investigation servent à trouver des expériences ; ils ne constituent pas des promesses de publications.']},
   {title:'2. Identifier et contacter les personnes',paragraphs:['Nous contactons principalement des personnes qui ont directement participé à une décision ou l’ont observée de près : dirigeants, salariés, responsables opérationnels, fournisseurs, utilisateurs, indépendants ou acteurs publics. Nous recherchons aussi des contrepoints et des éléments de vérification. Un lecteur peut signaler une expérience ou un éclairage intéressant. Un signalement ne vaut ni sélection ni promesse de publication.']},
   {title:'3. Préparer et conduire l’entretien',paragraphs:['Les questions sont élaborées pour rendre les situations et les arbitrages intelligibles, dans un cadre respectueux des informations confidentielles. Un échange préparatoire permet, lorsque nécessaire, de clarifier le périmètre de l’intervention.','La préparation ne consiste pas à écrire les réponses à la place de l’intervenant.']},
   {title:'4. Vérifier, restituer, mettre en regard',paragraphs:['La rédaction travaille la fidélité des propos, la cohérence des faits et leur présentation. Les lectures complémentaires peuvent ensuite être rapprochées au sein d’une même conversation, d’un cycle ou d’une analyse transversale.','Les publications de lancement prennent deux formes distinctes : des Scènes entièrement fictives, fondées sur des mécanismes documentés, et des Regards croisés analytiques, autonomes et étayés par des sources réelles.']},
   {title:'5. Expliquer notre pratique de l’anonymisation',paragraphs:['L’identité et la qualité d’une source réelle sont vérifiées par la rédaction selon les éléments auxquels elle a accès, même lorsqu’elles ne sont pas rendues publiques. Les notices de méthode accompagnant les articles doivent préciser ce qui peut être affirmé sur la provenance et le traitement du témoignage.','Une anonymisation peut supprimer ou généraliser certains éléments identifiants sans dénaturer la portée des décisions exposées. Aucune notice générique ne remplace une vérification propre à chaque entretien.','Un scénario fictif ou un texte de démonstration doit rester explicitement identifié comme tel et ne doit jamais être présenté comme le témoignage réel d’un intervenant.']},
   {title:'Une relation sans obligation de participation',paragraphs:['Une proposition de contribution, une invitation à échanger ou un entretien préparatoire ne garantissent ni la réalisation ni la publication d’un article. La rédaction apprécie la pertinence d’une contribution au regard de l’ensemble éditorial.']}
  ]}
} as const;
export function getStaticPaths(){return ['qui-sommes-nous','ligne-editoriale','notre-methode'].map(page=>({params:{page}}));}
const data=pages[Astro.params.page as keyof typeof pages];
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{data.nav} — Scènes d’Arbitrage</title><meta name="description" content={data.intro}/><style is:inline set:html={articleStyle}/></head><body>
<a class="skip" href="#contenu">Aller au contenu</a>
<MediaHeader/>
<main class="shell" id="contenu"><div class="reading institution-page"><p class="kicker"><a href="/media/">Accueil</a> / {data.nav}</p><p class="micro">{data.eyebrow}</p><h1>{data.title}</h1><p class="lead">{data.intro}</p>
{data.sections.map(s=><section class="institution-section"><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}
<section class="institution-next"><p class="micro">POURSUIVRE</p><h2>Explorer Scènes d’Arbitrage</h2><div class="institution-links"><a href="/media/institution/qui-sommes-nous/">Qui sommes-nous ?</a><a href="/media/institution/ligne-editoriale/">Notre ligne éditoriale</a><a href="/media/institution/notre-methode/">Notre méthode</a><a href="/media/publications/">Toutes les publications</a></div></section></div></main>
<MediaFooter/>
</body></html>
