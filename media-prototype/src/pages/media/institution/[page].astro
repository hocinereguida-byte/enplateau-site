---
import { articleStyle } from '../../../lib/article-style';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
const pages={
 'qui-sommes-nous':{
 nav:'Qui sommes-nous ?',eyebrow:'LE MÉDIA',title:'L’économie se joue dans les décisions.',
 intro:'Scènes d’Arbitrage est un média économique indépendant qui explore les choix, les contraintes et les raisonnements à l’œuvre dans l’économie réelle. Deux écritures complémentaires structurent sa démarche : la fiction économique documentée et l’analyse journalistique.',
 sections:[
 {title:'Pourquoi ce média ?',paragraphs:['Derrière chaque investissement, recrutement, transformation ou renoncement se croisent des contraintes parfois contradictoires. Une décision ne se comprend pas seulement par son résultat : il faut aussi examiner les alternatives, les incertitudes et les responsabilités.','Notre ambition est de rendre ces arbitrages intelligibles sans réduire l’économie aux annonces, aux chiffres isolés ou aux discours de communication.']},
 {title:'Les Scènes : explorer par la fiction',paragraphs:['Les Scènes prennent la forme de conversations imaginaires. Leurs personnages, entreprises, situations particulières et dialogues sont fictifs. Elles donnent à voir des dilemmes plausibles et des raisonnements économiques, sans prétendre restituer des entretiens réellement conduits.']},
 {title:'Les Regards croisés : comprendre par l’analyse',paragraphs:['Les Regards croisés sont des articles journalistiques autonomes. Ils examinent des mécanismes économiques à partir de sources réelles, de données et de travaux identifiables, en précisant leurs limites. Ils ne constituent pas des témoignages ni des preuves empiriques des situations racontées dans les Scènes.']},
 {title:'Des cycles et des lectures professionnelles',paragraphs:['Les cycles organisent les grandes questions par secteur économique ; les conversations structurent les thèmes à l’intérieur de chaque cycle. Les lectures professionnelles permettent d’explorer les décisions sous des angles complémentaires : stratégie, finance, droit, opérations, compétences et autres expertises pertinentes.','Les premiers terrains éditoriaux sont l’Industrie et le Logement & la fabrique des territoires.']},
 {title:'Indépendance éditoriale',paragraphs:['La rédaction choisit les sujets, les angles, les sources et les rapprochements. La présence d’une organisation dans un projet ou une contribution ne constitue pas une garantie de traitement favorable.','Scènes d’Arbitrage est une initiative éditoriale conçue et portée par Hocine Reguida.']}
 ]},
 'ligne-editoriale':{
 nav:'Notre ligne éditoriale',eyebrow:'NOS PRINCIPES',title:'La fiction pour explorer. L’analyse pour comprendre.',
 intro:'Deux registres d’écriture, une même exigence : rendre les décisions économiques plus compréhensibles sans confondre récit imaginé, fait vérifié et interprétation.',
 sections:[
 {title:'Des situations qui révèlent des choix',paragraphs:['Nous partons d’arbitrages concrets et plausibles : investir ou attendre, accepter une commande ou préserver la capacité productive, recruter ou transmettre des compétences. L’intérêt éditorial tient aux options, aux contraintes et aux conséquences.']},
 {title:'La fiction est annoncée comme telle',paragraphs:['Dans les Scènes, les personnages, dialogues et événements particuliers sont inventés. Les formulations incisives et les tensions narratives servent la compréhension, jamais la fabrication de faux témoignages. La mention de fiction économique documentée accompagne chaque publication concernée.']},
 {title:'L’analyse repose sur des sources vérifiables',paragraphs:['Les Regards croisés suivent une logique journalistique : questionnement, confrontation de références, contextualisation des chiffres, examen des limites et distinction entre faits et interprétations. Une source ne démontre pas davantage que ce qu’elle établit effectivement.']},
 {title:'Faire dialoguer les expertises',paragraphs:['Une décision peut être examinée à travers la stratégie, la finance, les opérations, le droit ou les compétences. Les cycles et les conversations sont construits selon la pertinence des angles, sans quota mécanique de métiers ou de publications.']},
 {title:'Indépendance et transparence',paragraphs:['La rédaction conserve ses choix éditoriaux et distingue ses contenus de toute communication promotionnelle. Les corrections factuelles et les limites documentaires doivent être traitées avant publication ; une validation narrative ne vaut pas validation des sources.']}
 ]},
 'notre-methode':{
 nav:'Notre méthode',eyebrow:'FABRICATION ÉDITORIALE',title:'Deux formats. Deux méthodes. Une exigence de clarté.',
 intro:'Les Scènes et les Regards croisés n’ont pas le même statut. Nous distinguons explicitement ce qui est imaginé, ce qui est documenté et ce qui relève de l’analyse.',
 sections:[
 {title:'1. Définir les questions économiques',paragraphs:['La rédaction identifie les mécanismes, contraintes et choix structurants d’un secteur. Elle les organise en cycles, conversations et lectures professionnelles selon leur pertinence éditoriale.']},
 {title:'2. Écrire les Scènes',paragraphs:['Les Scènes sont des dialogues de fiction économique documentée. La rédaction construit des personnages et des situations imaginaires pour mettre en tension des décisions plausibles. Aucun dialogue n’est présenté comme la transcription d’un entretien réel.','La crédibilité du mécanisme économique n’implique pas que l’événement fictif ait eu lieu.']},
 {title:'3. Produire les Regards croisés',paragraphs:['Les Regards croisés développent une analyse autonome. Ils s’appuient sur des références réelles, vérifiées autant que possible auprès des sources primaires, et distinguent les données, les modèles théoriques et leur interprétation.','Une référence valide un fait ou un mécanisme dans son périmètre ; elle ne prouve pas la réalité des personnages ou des événements imaginaires des Scènes.']},
 {title:'4. Trois validations distinctes',paragraphs:['La validation narrative porte sur la cohérence et la qualité du texte. La validation documentaire vérifie les faits, les chiffres, les références et les précautions d’interprétation. L’autorisation de publication est une décision séparée, prise une fois les contrôles éditoriaux et techniques satisfaits.']},
 {title:'5. Informer clairement le lecteur',paragraphs:['Chaque publication doit permettre d’identifier son format dès l’ouverture. Les Scènes portent une mention explicite de fiction ; les Regards croisés affichent leur statut d’analyse et leurs références pertinentes.','Les contributions externes peuvent signaler des questions ou des documents à examiner, mais elles ne transforment pas les Scènes en entretiens authentiques.']}
 ]}
} as const;
export function getStaticPaths(){return ['qui-sommes-nous','ligne-editoriale','notre-methode'].map(page=>({params:{page}}));}
const data=pages[Astro.params.page as keyof typeof pages];
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{data.nav} — Scènes d’Arbitrage</title><meta name="description" content={data.intro}/><style is:inline set:html={articleStyle}/></head><body>
<a class="skip" href="#contenu">Aller au contenu</a>
<MediaHeader/>
<main class="shell" id="contenu"><div class="reading institution-page"><p class="kicker"><a href="/media/">Accueil</a> / {data.nav}</p><p class="micro">{data.eyebrow}</p><h1>{data.title}</h1><p class="lead">{data.intro}</p>
{data.sections.map(s=><section class="institution-section"><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}
<section class="institution-next"><p class="micro">POURSUIVRE</p><h2>Explorer Scènes d’Arbitrage</h2><div class="institution-links"><a href="/media/institution/qui-sommes-nous/">Qui sommes-nous ?</a><a href="/media/institution/ligne-editoriale/">Notre ligne éditoriale</a><a href="/media/institution/notre-methode/">Notre méthode</a><a href="/media/publications/">Toutes les publications</a></div></section></div></main>
<MediaFooter/>
</body></html>
