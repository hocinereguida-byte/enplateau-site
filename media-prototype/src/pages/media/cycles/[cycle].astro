---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, conversations, publicPerspectiveLabel, publicGenreLabel, publicationInstant, cycleCatalogue, cycleBriefs, publicCycleLabel, publicCycleTechnicalLabel, cycleFamilies, publicFamilyLabel } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaFooter from '../../../components/MediaFooter.astro';
import MediaHeader from '../../../components/MediaHeader.astro';
export function getStaticPaths(){return cycleCatalogue.map(({code:cycle})=>({params:{cycle}}));}
const {cycle}=Astro.params;
const sourceCycle=cycle==='numerique'?'numerique-telecom':cycle;
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&(a.data.cycle===cycle||a.data.cycle===sourceCycle)).sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const cycleName=publicCycleLabel(cycle);
const technicalSector=publicCycleTechnicalLabel(cycle);
const family=cycleFamilies.find(f=>f.codes.some(code=>code===cycle));
const familyLabel=family?publicFamilyLabel(family.id):null;
const brief=cycleBriefs[cycle];
const conv=Object.entries(conversations[sourceCycle]||{}).map(([code,title])=>({code,title,items:items.filter(a=>a.data.conversation===code)})).filter(x=>x.items.length>0);
const labelGenre=(a:any)=>publicGenreLabel(a.data).toLocaleUpperCase('fr-FR')+(a.data.format==='regard-croise'?' · ANALYSE JOURNALISTIQUE':' · FICTION SATIRIQUE');
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/>
<title>{cycleName} — Scènes d’Arbitrage</title>
<meta name="description" content={technicalSector+' — '+(brief?.ambition??'Explorer les décisions et les arbitrages économiques')}/>
<style is:inline set:html={articleStyle}/>
<style is:global>
.sda-v5-cycle-intro{padding:35px 0 37px;border-bottom:1px solid #ddd8ce;display:grid;grid-template-columns:1.3fr .7fr;gap:44px;align-items:end}
.sda-v5-cycle-intro h1{font-size:clamp(44px,5.4vw,69px)!important;line-height:1.1!important;letter-spacing:-.05em!important;margin:10px 0 17px!important}
.sda-v5-cycle-intro .lead{font-size:17px!important;line-height:1.6!important;max-width:690px}
.sda-v5-cycle-overview{background:#e9e4da;padding:22px;border-left:3px solid #b94e39;font:15px/1.6 'IBM Plex Sans',sans-serif;color:#5d5951}
.sda-v5-cycle-overview p{margin:7px 0 0}
.sda-v5-cycle-group{margin-top:42px}
.sda-v5-cycle-group h2{font-size:clamp(29px,3vw,40px)!important;margin:9px 0 18px!important}
.sda-v5-cycle-kicker{font:700 10px/1.5 'IBM Plex Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:#b94e39}
.sda-v5-cycle-conversations{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.sda-v5-cycle-conv{background:#fffefa;border:1px solid #ded8ce;padding:25px;display:flex;flex-direction:column;min-height:188px}
.sda-v5-cycle-conv h3{font-size:clamp(24px,2.5vw,32px)!important;line-height:1.2;margin:10px 0 12px!important}
.sda-v5-cycle-conv h3 a{text-decoration:none}
.sda-v5-cycle-conv footer{margin-top:auto;color:#625e55;font-size:12px;display:flex;justify-content:space-between;padding-top:15px;border-top:1px solid #ddd8ce}
.sda-v5-cycle-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.sda-v5-cycle-article{background:#fffefa;border:1px solid #ded8ce;padding:22px;display:flex;flex-direction:column;min-height:250px}
.sda-v5-cycle-article h3{font-size:clamp(22px,2.2vw,29px)!important;line-height:1.19!important;margin:13px 0!important}
.sda-v5-cycle-article h3 a{text-decoration:none}
.sda-v5-cycle-article p:not(.sda-v5-cycle-kicker){font:13px/1.55 'IBM Plex Sans',sans-serif;color:#68645d}
.sda-v5-cycle-article footer{margin-top:auto;padding-top:12px;border-top:1px solid #ddd8ce;display:flex;justify-content:space-between;gap:8px;font:12px/1.4 'IBM Plex Sans',sans-serif}
.sda-v5-cycle-empty{background:#fffefa;border:1px solid #ded8ce;padding:28px;color:#666159}
.sda-v5-cycle-link{font-size:13px;text-underline-offset:4px}
@media(max-width:950px){.sda-v5-cycle-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.sda-v5-cycle-intro{grid-template-columns:1fr;gap:15px}}
@media(max-width:650px){.sda-v5-cycle-intro{padding:18px 0 27px}.sda-v5-cycle-intro h1{font-size:clamp(39px,10vw,51px)!important}.sda-v5-cycle-conversations,.sda-v5-cycle-grid{grid-template-columns:1fr}.sda-v5-cycle-article{min-height:0}.sda-v5-cycle-conv{min-height:0}}
.sda-v5-cycle-technical{font:500 13px/1.45 'IBM Plex Sans',Arial,sans-serif;color:#777168;margin:0 0 15px}
</style></head>
<body>
<a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/>
<main class="shell" id="contenu">
<nav class="kicker" aria-label="Fil d’Ariane"><a href="/media/">Accueil</a> / <a href="/media/cycles/">Là où ça se joue</a> / {familyLabel&&<>{familyLabel} / </>}{cycleName}</nav>
<header class="sda-v5-cycle-intro">
<div><p class="sda-v5-cycle-kicker">{familyLabel??'LÀ OÙ ÇA SE JOUE'}</p>
<h1>{cycleName}</h1><p class="sda-v5-cycle-technical">{technicalSector}</p><p class="lead">{brief?.ambition}</p>
<p class="sda-v5-cycle-kicker">{items.length ? items.length+' PUBLICATION'+(items.length>1?'S':'')+' DISPONIBLE'+(items.length>1?'S':'') : 'EN PRÉPARATION'}</p></div>
<div class="sda-v5-cycle-overview"><p class="sda-v5-cycle-kicker">LES ARBITRAGES</p><p>{brief?.enjeux_et_arbitrages}</p></div>
</header>
{conv.length>0&&<section class="sda-v5-cycle-group" aria-labelledby="cycle-conversations">
<p class="sda-v5-cycle-kicker">LES QUESTIONS</p><h2 id="cycle-conversations">Les sujets qui fâchent</h2>
<div class="sda-v5-cycle-conversations">{conv.map(c=><article class="sda-v5-cycle-conv">
<p class="sda-v5-cycle-kicker">SUJET {c.code}</p>
<h3><a href={'/media/cycles/'+sourceCycle+'/conversations/'+c.code+'/'}>{c.title}</a></h3>
<footer><span>{c.items.length} publication{c.items.length>1?'s':''}</span><a href={'/media/cycles/'+sourceCycle+'/conversations/'+c.code+'/'}>Explorer ↗</a></footer>
</article>)}</div></section>}
<section class="sda-v5-cycle-group" aria-labelledby="cycle-published">
<p class="sda-v5-cycle-kicker">À DÉCOUVRIR</p><h2 id="cycle-published">À lire dans ce secteur</h2>
{items.length ? <div class="sda-v5-cycle-grid">{items.map(a=><article class="sda-v5-cycle-article">
<p class="sda-v5-cycle-kicker">{labelGenre(a)}</p><h3><a href={urlOf(a.id)}>{a.data.title}</a></h3>
{a.data.summary&&<p>{a.data.summary}</p>}
<footer><span>{publicPerspectiveLabel(a.data.perspective_principale || a.data.lecture_principale || '') || 'Analyse documentée'}</span><a href={urlOf(a.id)}>Lire ↗</a></footer>
</article>)}</div> : <div class="sda-v5-cycle-empty"><p>Les premières publications de ce cycle sont en préparation.</p><a class="sda-v5-cycle-link" href="/media/publications/">Découvrir les publications disponibles ↗</a></div>}
</section>
<section class="sda-v5-cycle-group" aria-label="Méthode"><p class="sda-v5-cycle-kicker">NOTRE MÉTHODE</p><h2>La fiction pour explorer. L’analyse pour comprendre.</h2><p class="lead">{brief?.approche_narrative}</p></section>
</main><MediaFooter/></body></html>
