---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, conversations, contexts, readings, publicationInstant } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import { photoCycle, photoConversation, afficherPhotoListe } from '../../../lib/photographies';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
export function getStaticPaths(){return Object.keys(conversations).map(cycle=>({params:{cycle}}));}
const {cycle}=Astro.params;
const all=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data));
const items=all.filter(a=>a.data.cycle===cycle);
const cycleName=cycle==='industrie'?'Industrie et transformations industrielles':'Logement & fabrique des territoires';
const conv=Object.entries(conversations[cycle]||{});
const latest=[...items].sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const featured=latest.find(a=>a.data.mise_en_avant==='une')??latest[0];
const others=latest.filter(a=>a.id!==featured?.id).slice(0,6);
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{cycleName} — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head><body>
<MediaHeader/>
<main class="shell"><p class="kicker"><a href="/media/">Accueil</a> / Cycle</p><h1>{cycleName}</h1>{photoCycle(cycle)?<img class="rubric-hero-photo" src={photoCycle(cycle)} alt={`Photographie du cycle ${cycleName}`} loading="eager"/>:<div class="photo-placeholder photo-placeholder-rubric"><span>PHOTOGRAPHIE DU CYCLE</span></div>}<p class="lead">Sept conversations pour explorer les décisions, leurs conditions et leurs conséquences.</p>
<section aria-labelledby="conversations-heading"><h2 id="conversations-heading">Les sept conversations</h2><div class="cycle-conversation-list">{conv.map(([code,name])=><a class="cycle-compact-row" href={`/media/cycles/${cycle}/conversations/${code}/`}>{photoConversation(cycle,code)?<img class="rubric-thumb" src={photoConversation(cycle,code)} alt="" loading="lazy"/>:<span class="photo-placeholder photo-placeholder-thumb">PHOTO CONVERSATION</span>}<span class="cycle-compact-number">{code}</span><span class="cycle-compact-title">{name}</span><span class="cycle-compact-aside">{items.filter(a=>a.data.conversation===code).length>0?`${items.filter(a=>a.data.conversation===code).length} publication(s)`:'À découvrir'}</span></a>)}</div><a class="cycle-index-action" href="/media/conversations/">Rechercher dans toutes les conversations</a></section>
{featured&&<section class="cycle-editorial-selection" aria-labelledby="cycle-editorial-heading"><p class="micro">SÉLECTION ÉDITORIALE</p><h2 id="cycle-editorial-heading">À lire dans ce cycle</h2><article class="cycle-lead-article">{afficherPhotoListe(featured.data,"rubrique",0)&&(featured.data.hero_image?<img class="article-list-photo" src={featured.data.hero_image} alt={featured.data.seo?.image_alt||""} loading="lazy"/>:<div class="photo-placeholder photo-placeholder-feature"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>)}<p class="micro">{readings[featured.data.lecture_principale]}</p><h3><a href={urlOf(featured.id)}>{featured.data.title}</a></h3>{featured.data.summary&&<p>{featured.data.summary}</p>}</article><div class="cycle-stories">{others.map((a,i)=><article class="cycle-story">{afficherPhotoListe(a.data,"rubrique",i+1)&&(a.data.hero_image?<img class="article-list-photo" src={a.data.hero_image} alt={a.data.seo?.image_alt||""} loading="lazy"/>:<div class="photo-placeholder"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>)}<p class="micro">{readings[a.data.lecture_principale]}</p><h3><a href={urlOf(a.id)}>{a.data.title}</a></h3></article>)}</div></section>}
<section class="panel"><p class="micro">TROIS SITUATIONS</p><h2>Les contextes du cycle</h2><div class="cycle-context-list">{Object.entries(contexts[cycle]||{}).map(([code,name])=><a class="cycle-compact-row" href={`/media/cycles/${cycle}/contextes/${code}/`}><span class="cycle-compact-title">{name}</span><span class="cycle-compact-aside">{items.filter(a=>a.data.contexte===code).length>0?`${items.filter(a=>a.data.contexte===code).length} publication(s)`:'À découvrir'}</span></a>)}</div></section>
</main><MediaFooter/></body></html>