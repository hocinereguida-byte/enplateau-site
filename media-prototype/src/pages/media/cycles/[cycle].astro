---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, conversations, contexts, readings, publicationInstant, cycleCatalogue, cycleBriefs } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import { photoCycle, photoConversation, afficherPhotoListe } from '../../../lib/photographies';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
export function getStaticPaths(){return cycleCatalogue.map(({code:cycle})=>({params:{cycle}}));}
const {cycle}=Astro.params;
const all=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data));
const items=all.filter(a=>a.data.cycle===cycle);
const cycleName=cycleCatalogue.find(c=>c.code===cycle)?.label ?? cycle;
const brief=cycleBriefs[cycle];
const conv=Object.entries(conversations[cycle]||{}).filter(([code])=>items.some(a=>a.data.conversation===code));
const latest=[...items].sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const featured=latest.find(a=>a.data.mise_en_avant==='une')??latest[0];
const others=latest.filter(a=>a.id!==featured?.id).slice(0,6);
const cardSize=(a:any,i:number)=>a.data.taille_image_liste==="grande"?"large":a.data.taille_image_liste==="moyenne"?"medium":a.data.taille_image_liste==="vignette"?"thumb":a.data.taille_image_liste==="sans"?"none":i%4===0?"medium":i%4===1?"thumb":i%4===2?"none":"medium";
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{cycleName} — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/><style>.cycle-intro{max-width:780px;margin:30px 0 48px}.cycle-intro h2{margin:28px 0 10px}.cycle-intro p{font-size:17px;line-height:1.7;margin:0 0 18px}</style><style is:global>
.editorial-image-large .article-list-photo,.editorial-image-large .photo-placeholder{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}
.editorial-image-medium .article-list-photo,.editorial-image-medium .photo-placeholder{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
.editorial-image-thumb{display:grid!important;grid-template-columns:minmax(0,1fr) 112px;gap:12px 20px;align-items:start}
.editorial-image-thumb .article-list-photo,.editorial-image-thumb .photo-placeholder{grid-column:2;grid-row:1/5;width:112px;height:84px;object-fit:cover;min-height:0;margin:0}
.editorial-image-thumb > :not(.article-list-photo):not(.photo-placeholder){grid-column:1}
.editorial-image-none .article-list-photo,.editorial-image-none .photo-placeholder{display:none}
@media(max-width:600px){.editorial-image-thumb{grid-template-columns:minmax(0,1fr) 86px;gap:7px 12px}.editorial-image-thumb .article-list-photo,.editorial-image-thumb .photo-placeholder{width:86px;height:68px}}
</style></head><body>
<MediaHeader/>
<main class="shell"><p class="kicker"><a href="/media/">Accueil</a> / Cycle</p><h1>{cycleName}</h1>{photoCycle(cycle)?<img class="rubric-hero-photo" src={photoCycle(cycle)} alt={`Photographie du cycle ${cycleName}`} loading="eager"/>:<div class="photo-placeholder photo-placeholder-rubric"><span>PHOTOGRAPHIE DU CYCLE</span></div>}<section class="cycle-intro" aria-label="Présentation éditoriale"><h2>Ce que nous voulons comprendre</h2><p>{brief?.ambition}</p><h2>Pourquoi explorer ces décisions ?</h2><p>{brief?.enjeux_et_arbitrages}</p><h2>Pourquoi des Scènes et des Regards croisés ?</h2><p>{brief?.approche_narrative}</p></section>
{conv.length>=2&&<section aria-labelledby="conversations-heading"><h2 id="conversations-heading">Les conversations du cycle</h2><div class="cycle-conversation-list">{conv.map(([code,name])=><a class="cycle-compact-row" href={`/media/cycles/${cycle}/conversations/${code}/`}>{photoConversation(cycle,code)?<img class="rubric-thumb" src={photoConversation(cycle,code)} alt="" loading="lazy"/>:<span class="photo-placeholder photo-placeholder-thumb">PHOTO CONVERSATION</span>}<span class="cycle-compact-number">{code}</span><span class="cycle-compact-title">{name}</span><span class="cycle-compact-aside">{items.filter(a=>a.data.conversation===code).length>0?`${items.filter(a=>a.data.conversation===code).length} publication(s)`:'À découvrir'}</span></a>)}</div><a class="cycle-index-action" href="/media/conversations/">Rechercher dans toutes les conversations</a></section>}
{featured&&<section class="cycle-editorial-selection" aria-labelledby="cycle-editorial-heading"><p class="micro">SÉLECTION ÉDITORIALE</p><h2 id="cycle-editorial-heading">À lire dans ce cycle</h2><article class={`cycle-lead-article editorial-image-${featured.data.taille_image_liste==="automatique"||!featured.data.taille_image_liste?"large":featured.data.taille_image_liste==="grande"?"large":featured.data.taille_image_liste==="moyenne"?"medium":featured.data.taille_image_liste==="vignette"?"thumb":"none"}`}>{featured.data.taille_image_liste!=="sans"&&afficherPhotoListe(featured.data,"rubrique",0)&&(featured.data.hero_image?<img class="article-list-photo" src={featured.data.hero_image} alt={featured.data.seo?.image_alt||""} loading="lazy"/>:<div class="photo-placeholder photo-placeholder-feature"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>)}<p class="micro">{featured.data.format==='regard-croise'?'REGARD CROISÉ — ANALYSE':'SCÈNE — FICTION DOCUMENTÉE'} · {readings[featured.data.lecture_principale]}</p><h3><a href={urlOf(featured.id)}>{featured.data.title}</a></h3>{featured.data.summary&&<p>{featured.data.summary}</p>}</article><div class="editorial-mosaic">{others.map((a,i)=><article class={`editorial-card editorial-card--${cardSize(a,i)}`}><p class="micro">{a.data.format==='regard-croise'?'REGARD CROISÉ — ANALYSE':'SCÈNE — FICTION DOCUMENTÉE'} · {readings[a.data.lecture_principale]}</p>{cardSize(a,i)!=="none"&&(a.data.hero_image?<img class="editorial-card-image" src={a.data.hero_image} alt={a.data.seo?.image_alt||""} loading="lazy"/>:<div class="photo-placeholder"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>)}<h3><a href={urlOf(a.id)}>{a.data.title}</a></h3></article>)}</div></section>}
{items.length>0&&Object.entries(contexts[cycle]||{}).some(([code])=>items.some(a=>a.data.contexte===code))&&<section class="panel"><p class="micro">SITUATIONS ÉCONOMIQUES</p><h2>Explorer les contextes</h2><div class="cycle-context-list">{Object.entries(contexts[cycle]||{}).filter(([code])=>items.some(a=>a.data.contexte===code)).map(([code,name])=><a class="cycle-compact-row" href={`/media/cycles/${cycle}/contextes/${code}/`}><span class="cycle-compact-title">{name}</span><span class="cycle-compact-aside">{items.filter(a=>a.data.contexte===code).length>0?`${items.filter(a=>a.data.contexte===code).length} publication(s)`:'À découvrir'}</span></a>)}</div></section>}
</main><MediaFooter/></body></html>