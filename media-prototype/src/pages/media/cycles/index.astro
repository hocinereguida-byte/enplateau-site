---
import { conversations, readings } from '../../../lib/editorial';
import { photoCycle, photoLecture } from '../../../lib/photographies';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
const entries=Object.keys(conversations).map(code=>({code,label:code==='industrie'?'Industrie et transformations industrielles':'Logement & fabrique des territoires',url:'/media/cycles/'+code+'/',photo:photoCycle(code)}));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Tous les cycles — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head><body><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main id="contenu" class="shell"><p class="micro">EXPLORER LE MÉDIA</p><h1>Tous les cycles économiques</h1><p class="lead">Deux cycles inauguraux, de nouveaux secteurs à explorer progressivement.</p><div class="directory-grid">{entries.map(item=><a class="directory-tile" href={item.url}>{item.photo&&<img src={item.photo} alt="" loading="lazy"/>}<span class="micro">CYCLE</span><h2>{item.label}</h2><span aria-hidden="true">Découvrir ↗</span></a>)}</div><p><a href="/media/conversations/">Rechercher parmi toutes les conversations</a></p></main><MediaFooter/></body></html>