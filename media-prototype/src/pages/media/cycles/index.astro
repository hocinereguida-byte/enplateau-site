---
import { cycleCatalogue, cycleFamilies, cycleBriefs, publicCycleLabel, publicFamilyLabel } from '../../../lib/editorial';
import { photoCycle } from '../../../lib/photographies';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Là où ça se joue — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head>
<body><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/>
<main id="contenu" class="shell">
<p class="micro">EXPLORER LE MÉDIA</p><h1>Là où ça se joue</h1>
<p class="lead">Six grands univers et vingt rubriques pour explorer les décisions économiques. Les noms de presse mettent les enjeux en scène ; les secteurs restent indiqués pour se repérer.</p>
{cycleFamilies.map(family=><section class="cycle-family-directory"><h2>{publicFamilyLabel(family.id)}</h2><p class="micro">{family.label}</p><div class="directory-grid">{family.codes.map(code=>{const item=cycleCatalogue.find(c=>c.code===code)!;return <a class="directory-tile" href={`/media/cycles/${item.code}/`}>{photoCycle(item.code)?<img src={photoCycle(item.code)} alt="" loading="lazy"/>:<div class="photo-placeholder"><span>SECTEUR ÉCONOMIQUE</span></div>}<span class="micro">SECTEUR {String(item.number).padStart(2,'0')}</span><h3>{publicCycleLabel(item.code)}</h3><p class="micro">{item.label}</p><p>{cycleBriefs[item.code]?.ambition}</p><span>Découvrir le secteur ↗</span></a>})}</div></section>)}
<p><a href="/media/publications/">Explorer les publications disponibles</a></p>
</main><MediaFooter/></body></html>