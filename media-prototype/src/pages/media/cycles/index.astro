---
import { cycleCatalogue } from '../../../lib/editorial';
import { photoCycle } from '../../../lib/photographies';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Les 20 cycles — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head>
<body><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/>
<main id="contenu" class="shell">
<p class="micro">EXPLORER LE MÉDIA</p><h1>Les 20 cycles économiques</h1>
<p class="lead">Vingt champs pour explorer l’économie réelle. Industrie et Immobilier disposent déjà de publications ; les dix-huit autres cycles sont présentés comme des perspectives éditoriales en préparation. Leurs intitulés et périmètres pourront évoluer.</p>
<div class="directory-grid">
{cycleCatalogue.map(item=>item.programmed?
<a class="directory-tile" href={`/media/cycles/${item.code}/`}>
{photoCycle(item.code)?<img src={photoCycle(item.code)} alt="" loading="lazy"/>:<div class="photo-placeholder"><span>CYCLE ÉCONOMIQUE</span></div>}
<span class="micro">CYCLE {String(item.number).padStart(2,'0')} · EXPLORER</span><h2>{item.label}</h2><span>Voir les publications ↗</span>
</a>:
<div class="directory-tile" style="cursor:default">
<div class="photo-placeholder" aria-hidden="true"><span>SCÈNES D’ARBITRAGE</span></div>
<span class="micro">CYCLE {String(item.number).padStart(2,'0')} · EN PRÉPARATION</span><h2>{item.label}</h2><span>Programmation éditoriale à venir</span>
</div>)}
</div>
<p><a href="/media/publications/">Explorer les publications disponibles</a></p>
</main><MediaFooter/></body></html>