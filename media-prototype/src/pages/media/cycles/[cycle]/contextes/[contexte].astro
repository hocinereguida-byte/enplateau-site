---
import { getCollection } from 'astro:content';
import { isPublic,validClassification,urlOf,conversations,contexts,publicContextLabel,publicPerspectiveLabel,publicGenreLabel,perspectiveOf,cycleCatalogue, canonicalCycleCode, publicCycleLabel } from '../../../../../lib/editorial';
import { articleStyle } from '../../../../../lib/article-style';
import MediaFooter from '../../../../../components/MediaFooter.astro'
import MediaHeader from '../../../../../components/MediaHeader.astro';;
export function getStaticPaths(){return Object.entries(contexts).flatMap(([cycle,group])=>Object.keys(group).map(contexte=>({params:{cycle,contexte}})));}
const {cycle,contexte}=Astro.params;
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.cycle===cycle&&a.data.contexte===contexte);
const name=publicContextLabel(cycle,contexte);
const technicalContext=contexts[cycle]?.[contexte];
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{name} — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head><body><MediaHeader/><main class="shell"><p class="kicker"><a href="/media/">Accueil</a> / <a href={`/media/cycles/${canonicalCycleCode(cycle)}/`}>{publicCycleLabel(cycle)}</a> / Les cas de figure</p><p class="micro">LES CAS DE FIGURE</p><h1>{name}</h1>{technicalContext&&technicalContext!==name&&<p class="small">{technicalContext}</p>}<p class="lead">Les contributions qui examinent une situation économique sous plusieurs angles, dans les sujets qui fâchent.</p>
{items.length===0?<p>Aucun article publié pour le moment.</p>:<div class="cards">{items.map(a=><article class="card"><p class="kicker">{conversations[cycle]?.[a.data.conversation]} · {publicPerspectiveLabel(perspectiveOf(a.data)) || publicGenreLabel(a.data)}</p><h2><a href={urlOf(a.id)}>{a.data.title}</a></h2><p>{a.data.summary}</p></article>)}</div>}</main><MediaFooter/></body></html>