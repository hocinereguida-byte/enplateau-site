---
import { getCollection } from 'astro:content';
import { isPublic,validClassification,urlOf,conversations,contexts,readings } from '../../../../../lib/editorial';
import { articleStyle } from '../../../../../lib/article-style';
import { photoConversation, afficherPhotoListe } from '../../../../../lib/photographies';
import MediaFooter from '../../../../../components/MediaFooter.astro'
import MediaHeader from '../../../../../components/MediaHeader.astro';;
export function getStaticPaths(){return Object.entries(conversations).flatMap(([cycle,group])=>Object.keys(group).map(conversation=>({params:{cycle,conversation}})));}
const {cycle,conversation}=Astro.params;
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.cycle===cycle&&a.data.conversation===conversation);
const name=conversations[cycle]?.[conversation];
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{name} — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head><body><MediaHeader/><main class="shell"><p class="kicker"><a href="/media/">Accueil</a> / <a href={`/media/cycles/${cycle}/`}>{cycle}</a> / {conversation}</p><h1>{name}</h1>{photoConversation(cycle,conversation)&&<img class="rubric-hero-photo" src={photoConversation(cycle,conversation)} alt={`Photographie de la conversation ${name}`} loading="eager"/>}<p class="lead">Une grande question économique explorée à travers des situations concrètes, des décisions documentées et plusieurs lectures professionnelles.</p>
{Object.entries(contexts[cycle]||{}).map(([key,label])=><section class="panel"><h2>{label}</h2>{items.filter(a=>a.data.contexte===key).length===0?<p class="small">Aucun article publié pour le moment.</p>:<div class="cards">{items.filter(a=>a.data.contexte===key).map((a,i)=><article class="card">{a.data.hero_image&&afficherPhotoListe(a.data,"rubrique",i)&&<img class="article-list-photo" src={a.data.hero_image} alt={a.data.seo?.image_alt||""} loading="lazy"/>}<p class="kicker">{readings[a.data.lecture_principale]}</p><h3><a href={urlOf(a.id)}>{a.data.title}</a></h3><p>{a.data.summary}</p></article>)}</div>}</section>)}
<section class="contribute-callout"><p class="micro">VOTRE EXPÉRIENCE</p><h2>Un éclairage sur cette conversation ?</h2><p>Signalez une décision ou une situation que votre expérience pourrait aider à comprendre. La rédaction examine les propositions sans engagement de publication.</p><a href={`/media/proposer-un-eclairage/?cycle=${encodeURIComponent(cycle)}&conversation=${encodeURIComponent(conversation)}`}>Proposer un éclairage</a></section>
</main><MediaFooter/></body></html>