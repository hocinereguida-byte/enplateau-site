---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, conversations, contexts, readings, publicationInstant, perspectiveOf, genreOf, narrativeGenres, cycleCatalogue } from '../../../../../lib/editorial';
import { articleStyle } from '../../../../../lib/article-style';
import MediaFooter from '../../../../../components/MediaFooter.astro';
import MediaHeader from '../../../../../components/MediaHeader.astro';
export async function getStaticPaths(){
  const published=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data));
  return Object.entries(conversations).flatMap(([cycle,group])=>Object.keys(group)
    .filter(conversation=>published.some(a=>a.data.cycle===cycle&&a.data.conversation===conversation))
    .map(conversation=>({params:{cycle,conversation}})));
}
const {cycle,conversation}=Astro.params;
const items=(await getCollection('articles'))
  .filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.cycle===cycle&&a.data.conversation===conversation)
  .sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
const name=conversations[cycle]?.[conversation]??conversation;
const cycleName=cycleCatalogue.find(x=>x.code===cycle)?.label??cycle;
const contextGroups=Object.entries(contexts[cycle]||{}).map(([code,label])=>({code,label,articles:items.filter(a=>a.data.contexte===code)})).filter(group=>group.articles.length>0);
const genreName=(a:any)=>a.data.format==='regard-croise'?'Regard croisé':(narrativeGenres[genreOf(a.data)??'']??'Scène');
---
<!doctype html>
<html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/>
<title>{name} — Scènes d’Arbitrage</title>
<meta name="description" content={'Explorer la conversation '+name+' : des décisions économiques examinées sous différents angles.'}/>
<style is:inline set:html={articleStyle}/>
<style is:global>
.sda-v5-conv-kicker{font:700 10px/1.6 'IBM Plex Mono',monospace;letter-spacing:.12em;text-transform:uppercase;color:#b94e39}
.sda-v5-conv-intro{margin:26px 0 40px;padding-bottom:30px;border-bottom:1px solid #ddd7cb}
.sda-v5-conv-intro h1{max-width:850px;font-size:clamp(43px,5vw,67px)!important;letter-spacing:-.045em!important;line-height:1.09!important;margin:14px 0 20px}
.sda-v5-conv-intro .lead{max-width:760px;margin:0!important}
.sda-v5-conv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.sda-v5-conv-context{margin:0 0 44px}
.sda-v5-conv-context h2{font-size:clamp(27px,3vw,36px)!important;margin:10px 0 22px!important}
.sda-v5-conv-card{background:#fffefa;border:1px solid #ddd7cb;padding:22px;display:flex;flex-direction:column;min-height:235px}
.sda-v5-conv-card h3{font-size:clamp(24px,2.7vw,32px)!important;line-height:1.2;margin:12px 0!important}
.sda-v5-conv-card h3 a{text-decoration:none}
.sda-v5-conv-card>p:not(.sda-v5-conv-kicker){font:14px/1.6 'IBM Plex Sans',sans-serif;color:#65615b;margin:0 0 15px}
.sda-v5-conv-card footer{margin-top:auto;border-top:1px solid #ddd7cb;padding-top:14px;font:12px/1.5 'IBM Plex Sans',sans-serif;color:#56534c}
.sda-v5-conv-card footer a{float:right;text-decoration:none}
.sda-v5-conv-back{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:24px 0;border-top:1px solid #ddd7cb;font:600 13px/1.4 'IBM Plex Sans',sans-serif}
@media(max-width:720px){.sda-v5-conv-intro{margin:15px 0 30px}.sda-v5-conv-intro h1{font-size:42px!important}.sda-v5-conv-grid{grid-template-columns:1fr}.sda-v5-conv-card{min-height:0}.sda-v5-conv-back{display:block}.sda-v5-conv-back a{display:block;margin-bottom:15px}}
</style></head>
<body>
<a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/>
<main class="shell" id="contenu">
<nav class="kicker" aria-label="Fil d’Ariane"><a href="/media/">Accueil</a> / <a href="/media/cycles/">Cycles</a> / <a href={'/media/cycles/'+cycle+'/'}>{cycleName}</a> / {name}</nav>
<header class="sda-v5-conv-intro">
<p class="sda-v5-conv-kicker">CONVERSATION {conversation} · {cycleName.toUpperCase()}</p>
<h1>{name}</h1>
<p class="lead">Une grande question économique explorée à travers des décisions, des contraintes et des perspectives différentes.</p>
<p class="sda-v5-conv-kicker">{items.length} PUBLICATION{items.length>1?'S':''} DISPONIBLE{items.length>1?'S':''}</p>
</header>
{contextGroups.map(group=><section class="sda-v5-conv-context" aria-labelledby={'ctx-'+group.code}>
<p class="sda-v5-conv-kicker">SITUATION ÉCONOMIQUE</p><h2 id={'ctx-'+group.code}>{group.label}</h2>
<div class="sda-v5-conv-grid">{group.articles.map(a=><article class="sda-v5-conv-card">
<p class="sda-v5-conv-kicker">{genreName(a)} · {readings[perspectiveOf(a.data)]??cycleName}</p>
<h3><a href={urlOf(a.id)}>{a.data.title}</a></h3>
{a.data.summary&&<p>{a.data.summary}</p>}
<footer><span>{readings[perspectiveOf(a.data)]??'Analyse documentée'}</span><a href={urlOf(a.id)}>Lire ↗</a></footer>
</article>)}</div></section>)}
<nav class="sda-v5-conv-back" aria-label="Continuer à explorer">
<a href={'/media/cycles/'+cycle+'/'}>← Explorer le cycle {cycleName}</a>
<a href="/media/publications/">Toutes les publications ↗</a>
</nav>
</main><MediaFooter/>
</body></html>
