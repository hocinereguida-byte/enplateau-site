---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, publicPerspectiveLabel, publicationInstant, genreOf, narrativeGenres, perspectiveOf } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
const genres=['chronique','grand-entretien'];
const articles=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.format!=='regard-croise').sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Fictions satiriques — Scènes d’Arbitrage</title><meta name="description" content="Comédies économiques et Grands Entretiens : des fictions satiriques documentées, où personnages, situations et dialogues sont imaginaires."/><style is:inline set:html={articleStyle}/><style is:global>
.scenes-front{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.65fr) minmax(0,.8fr);gap:22px;border-top:2px solid #ad9788;padding:20px 0 28px}
.scenes-front>*{min-width:0}.scenes-lead{padding-right:18px;border-right:1px solid #d5bdad}.scenes-lead h3{font:600 clamp(25px,2.4vw,37px)/1.2 'Playfair Display',Georgia,serif;margin:10px 0}.scenes-lead h3 a,.scenes-picks h3 a,.scenes-story a{color:#262a33;text-decoration:none}.scenes-lead p:not(.micro){font-size:15px;line-height:1.6;color:#5e554e}
.scenes-visual{display:block;color:#262a33;text-decoration:none;background:#eedccc;align-self:start}.scenes-visual img,.scenes-visual .photo-placeholder{display:block;width:100%;aspect-ratio:16/10;object-fit:cover;margin:0}.scenes-visual h3{font:600 clamp(21px,2vw,29px)/1.3 'Playfair Display',Georgia,serif;margin:0;padding:15px}
.scenes-picks{border-left:1px solid #d5bdad;padding-left:16px}.scenes-picks article{border-top:1px solid #cbb4a5;padding-top:12px;margin-top:12px}.scenes-picks h3{font:600 18px/1.3 'Playfair Display',Georgia,serif;margin:0}
.scenes-story-grid{border-top:3px double #ad9788;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;padding-top:23px}.scenes-story{min-width:0}.scenes-story img,.scenes-story .photo-placeholder{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.scenes-story h3{font:600 20px/1.3 'Playfair Display',Georgia,serif;margin:10px 0}.scenes-story p{font-size:13px;line-height:1.5;color:#65584f}
@media(max-width:940px){.scenes-front{grid-template-columns:1fr 1.4fr}.scenes-picks{grid-column:1/-1;border-left:0;border-top:1px solid #d5bdad;padding:12px 0}.scenes-story-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){.scenes-front{grid-template-columns:1fr}.scenes-visual{grid-row:1}.scenes-lead{border-right:0;padding-right:0}.scenes-picks{grid-column:1}.scenes-story-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}}
</style></head><body class="media-home"><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main id="contenu" class="home-shell"><section class="home-intro"><p class="micro">SCÈNES D’ARBITRAGE · FICTION ÉCONOMIQUE DOCUMENTÉE</p><h1>Les fictions satiriques</h1><p class="home-standfirst">Des comédies courtes et des entretiens fictifs pour raconter les contradictions économiques. Personnages, situations et dialogues sont imaginaires.</p><div class="intro-links">{genres.map(g=><a href={`#${g}`}>{narrativeGenres[g]}</a>)}<a href="/media/">Retour à la une</a><a href="/media/regards-croises/">Lire Le fond du problème</a></div></section>{genres.map(g=>{const group=articles.filter(a=>genreOf(a.data)===g);return <section id={g} class="home-section" aria-label={narrativeGenres[g]}><h2>{narrativeGenres[g]}</h2>{group.length?<><div class="scenes-front">
<article class="scenes-lead"><p class="micro">FICTION ÉCONOMIQUE · {publicPerspectiveLabel(perspectiveOf(group[0].data))}</p><h3><a href={urlOf(group[0].id)}>{group[0].data.title}</a></h3>{group[0].data.summary&&<p>{group[0].data.summary}</p>}</article>
{group.length>1&&<a class="scenes-visual" href={urlOf(group[1].id)}>{group[1].data.hero_image?<img src={group[1].data.hero_image} alt="" loading="lazy"/>:<div class="photo-placeholder"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>}<h3>{group[1].data.title}</h3></a>}
{group.length>2&&<aside class="scenes-picks"><p class="micro">À DÉCOUVRIR</p>{group.slice(2,5).map(a=><article><h3><a href={urlOf(a.id)}>{a.data.title}</a></h3></article>)}</aside>}
</div>
{group.length>5&&<div class="scenes-story-grid">{group.slice(5).map(a=><article class="scenes-story"><a href={urlOf(a.id)}>{a.data.hero_image?<img src={a.data.hero_image} alt="" loading="lazy"/>:<div class="photo-placeholder"><span>PHOTOGRAPHIE DE L’ARTICLE</span></div>}<h3>{a.data.title}</h3></a><p>{a.data.summary}</p></article>)}</div>}</>:<p>Aucune publication disponible dans ce genre pour le moment.</p>}</section>})}</main><MediaFooter/></body></html>