---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, publicationInstant, genreOf, narrativeGenres, perspectiveOf } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
const genres=['grand-entretien','recit','chronique'];
const articles=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.format!=='regard-croise').sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Les Scènes — Scènes d’Arbitrage</title><meta name="description" content="Grands Entretiens, Récits et Chroniques : des fictions économiques documentées, parfois satiriques, qui explorent des décisions plausibles. Personnages et situations sont imaginaires."/><style is:inline set:html={articleStyle}/></head><body class="media-home"><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main id="contenu" class="home-shell"><section class="home-intro"><p class="micro">SCÈNES D’ARBITRAGE · FICTION ÉCONOMIQUE DOCUMENTÉE</p><h1>Les Scènes</h1><p class="home-standfirst">Des entretiens fictifs, des décisions plausibles et des mécanismes économiques documentés. Personnages, situations et dialogues sont imaginaires.</p><div class="intro-links">{genres.map(g=><a href={`#${g}`}>{narrativeGenres[g]}</a>)}<a href="/media/">Retour à la une</a><a href="/media/regards-croises/">Explorer les Regards croisés</a></div></section>{genres.map(g=>{const group=articles.filter(a=>genreOf(a.data)===g);return <section id={g} class="home-section" aria-label={narrativeGenres[g]}><h2>{narrativeGenres[g]}</h2>{group.length?<div class="cycle-list">{group.map(a=><a class="cycle-row" href={urlOf(a.id)}><span class="cycle-index">FICTION ÉCONOMIQUE · {narrativeGenres[g]}</span><span class="cycle-title">{a.data.title}</span><span class="cycle-description">{a.data.summary} · {readings[perspectiveOf(a.data)]}</span><span class="cycle-arrow" aria-hidden="true">↗</span></a>)}</div>:<p>Premières publications à venir.</p>}</section>})}</main><MediaFooter/></body></html>