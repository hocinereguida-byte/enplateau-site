---
import { getCollection } from 'astro:content';
import { isPublic,validClassification,urlOf,conversations,readings,perspectiveOf } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import { photoLecture, afficherPhotoListe } from '../../../lib/photographies';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
export function getStaticPaths(){return Object.keys(readings).map(lecture=>({params:{lecture}}));}
const {lecture}=Astro.params;
const published=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data));
const items=published.filter(a=>a.data.format==='entretien'&&perspectiveOf(a.data)===lecture);
const complementary=published.filter(a=>a.data.format==='regard-croise');
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{readings[lecture]} — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head><body><MediaHeader/><main class="shell"><p class="kicker"><a href="/media/">Accueil</a> / Perspective éditoriale</p><h1>{readings[lecture]}</h1>{photoLecture(lecture)?<img class="rubric-hero-photo" src={photoLecture(lecture)} alt={`Photographie de la perspective ${readings[lecture]}`} loading="eager"/>:<div class="photo-placeholder photo-placeholder-rubric"><span>PHOTOGRAPHIE DE LA PERSPECTIVE</span></div>}<p class="lead">Cette perspective oriente les questions, les contraintes et les alternatives examinées dans les Scènes. Les Regards croisés apportent séparément une analyse fondée sur des sources réelles.</p>
{items.length===0?<p>Aucun article publié pour le moment.</p>:<div class="cards">{items.map((a,i)=><article class="card">{a.data.hero_image&&afficherPhotoListe(a.data,"rubrique",i)&&<img class="article-list-photo" src={a.data.hero_image} alt={a.data.seo?.image_alt||""} loading="lazy"/>}<p class="kicker">{a.data.format==='regard-croise'?'REGARD CROISÉ — ANALYSE':'SCÈNE — FICTION DOCUMENTÉE'} · {a.data.cycle} · {conversations[a.data.cycle]?.[a.data.conversation]}</p><h2><a href={urlOf(a.id)}>{a.data.title}</a></h2><p>{a.data.summary}</p></article>)}</div>}
{complementary.length>0&&<section class="recommendations" aria-labelledby="complementary-heading"><p class="kicker">POUR PROLONGER LA RÉFLEXION</p><h2 id="complementary-heading">Regards croisés · Analyses complémentaires</h2><p class="lead">Ces analyses documentaires éclairent les décisions économiques au-delà d'une seule lecture professionnelle. Elles sont proposées séparément des Scènes.</p><div class="recommendation-links">{complementary.map(a=><a class="recommendation-card" href={urlOf(a.id)}><span class="micro">REGARD CROISÉ · {a.data.cycle}</span><strong>{a.data.title}</strong></a>)}</div></section>}</main><MediaFooter/></body></html>