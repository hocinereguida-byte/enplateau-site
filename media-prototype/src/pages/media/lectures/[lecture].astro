---
import { getCollection } from 'astro:content';
import { isPublic,validClassification,urlOf,conversations,readings } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import { photoLecture, afficherPhotoListe } from '../../../lib/photographies';
import MediaFooter from '../../../components/MediaFooter.astro'
import MediaHeader from '../../../components/MediaHeader.astro';;
export function getStaticPaths(){return Object.keys(readings).map(lecture=>({params:{lecture}}));}
const {lecture}=Astro.params;
const items=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.lecture_principale===lecture);
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{readings[lecture]} — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head><body><MediaHeader/><main class="shell"><p class="kicker"><a href="/media/">Accueil</a> / Lecture professionnelle</p><h1>{readings[lecture]}</h1>{photoLecture(lecture)?<img class="rubric-hero-photo" src={photoLecture(lecture)} alt={`Photographie de la lecture ${readings[lecture]}`} loading="eager"/>:<div class="photo-placeholder photo-placeholder-rubric"><span>PHOTOGRAPHIE DE LA LECTURE</span></div>}<p class="lead">Ce regard professionnel éclaire certaines dimensions des décisions, à travers des expériences documentées et plusieurs secteurs, sans prétendre à une grille unique pour chaque situation.</p>
{items.length===0?<p>Aucun article publié pour le moment.</p>:<div class="cards">{items.map((a,i)=><article class="card">{a.data.hero_image&&afficherPhotoListe(a.data,"rubrique",i)&&<img class="article-list-photo" src={a.data.hero_image} alt={a.data.seo?.image_alt||""} loading="lazy"/>}<p class="kicker">{a.data.cycle} · {conversations[a.data.cycle]?.[a.data.conversation]}</p><h2><a href={urlOf(a.id)}>{a.data.title}</a></h2><p>{a.data.summary}</p></article>)}</div>}</main><MediaFooter/></body></html>