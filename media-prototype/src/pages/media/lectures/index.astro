---
import { publicPerspectives } from '../../../lib/editorial';
import { photoCycle, photoLecture } from '../../../lib/photographies';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
const entries=Object.entries(publicPerspectives).map(([code,entry])=>({code,label:entry.label,description:entry.description,url:'/media/lectures/'+code+'/',photo:photoLecture(code)}));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Les angles morts — Scènes d’Arbitrage</title><style is:inline set:html={articleStyle}/></head><body><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main id="contenu" class="shell"><p class="micro">EXPLORER LE MÉDIA</p><h1>Les angles morts</h1><p class="lead">Huit points de vue sur les décisions économiques : ce que la stratégie, la finance, le droit, l’organisation, la technologie, les ressources humaines, l’énergie et les territoires nous font voir — ou oublier.</p><div class="directory-grid">{entries.map(item=><a class="directory-tile" href={item.url}>{item.photo?<img src={item.photo} alt="" loading="lazy"/>:<div class="photo-placeholder"><span>ILLUSTRATION DU POINT DE VUE</span></div>}<span class="micro">UN ANGLE MORT</span><h2>{item.label}</h2><p>{item.description}</p><span aria-hidden="true">Découvrir ↗</span></a>)}</div></main><MediaFooter/></body></html>