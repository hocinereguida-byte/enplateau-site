---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, conversations } from '../../../lib/editorial';
import { photoConversation } from '../../../lib/photographies';
import registry from '../../../../../content/rubriques/conversations.json';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
const publicArticles=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data));
const catalogue=Object.entries(conversations).flatMap(([cycle,group])=>Object.entries(group).map(([code,title])=>{
 const metadata=(registry.conversations as Record<string,{titre:string;presentation:string;questions:string;mots_cles:string}>)[cycle+'_'+code];
 return {cycle,code,title,description:metadata?.presentation||'',questions:metadata?.questions||'',keywords:metadata?.mots_cles||'',photo:photoConversation(cycle,code),count:publicArticles.filter(a=>a.data.cycle===cycle&&a.data.conversation===code).length,url:`/media/cycles/${cycle}/conversations/${code}/`};
}));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Toutes les conversations — Scènes d’Arbitrage</title><meta name="description" content="Rechercher les questions économiques et explorer les conversations par cycle et par sujet."/><style is:inline set:html={articleStyle}/></head><body><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main id="contenu" class="shell conversation-directory"><p class="micro">LES QUESTIONS ÉCONOMIQUES</p><h1>Explorer les conversations</h1><p class="lead">Retrouvez les questions qui structurent nos cycles éditoriaux, par secteur ou par mot-clé.</p>
<div class="conversation-filters"><label for="conversation-search">Rechercher une conversation</label><input type="search" id="conversation-search" placeholder="Question, sujet, arbitrage, mot-clé…" autocomplete="off"/><label for="conversation-cycle">Cycle économique</label><select id="conversation-cycle"><option value="">Tous les cycles</option><option value="industrie">Industrie</option><option value="immobilier">Logement & fabrique des territoires</option></select><div class="conversation-controls"><button type="button" id="conversation-reset">Effacer les filtres</button><span id="conversation-count" role="status" aria-live="polite">{catalogue.length} conversations</span></div></div>
<div class="conversation-results" id="conversation-results">{catalogue.map(item=><article class="conversation-result" data-cycle={item.cycle} data-search={[item.cycle,item.code,item.title,item.description,item.questions,item.keywords].join(' ').toLocaleLowerCase('fr-FR')}><a class="conversation-result-link" href={item.url}>{item.photo?<img class="conversation-result-photo" src={item.photo} alt="" loading="lazy"/>:<span class="photo-placeholder photo-placeholder-thumb">PHOTO CONVERSATION</span>}<div><p class="micro">{item.cycle==='industrie'?'INDUSTRIE':'LOGEMENT & TERRITOIRES'} · {item.code}</p><h2>{item.title}</h2>{item.description&&<p>{item.description}</p>}<span class="conversation-result-count">{item.count} publication(s)</span></div><span class="conversation-result-arrow" aria-hidden="true">↗</span></a></article>)}</div><p id="conversation-empty" hidden>Aucune conversation ne correspond à cette recherche.</p></main><MediaFooter/>
<script is:inline>
(function(){const query=document.getElementById('conversation-search'),cycle=document.getElementById('conversation-cycle'),count=document.getElementById('conversation-count'),empty=document.getElementById('conversation-empty');const rows=[...document.querySelectorAll('.conversation-result')];const normalize=s=>(s||'').toLocaleLowerCase('fr-FR').normalize('NFD').replace(/[\u0300-\u036f]/g,'');const apply=()=>{let n=0;const term=normalize(query.value.trim());rows.forEach(el=>{const show=(!cycle.value||el.dataset.cycle===cycle.value)&&normalize(el.dataset.search).includes(term);el.hidden=!show;if(show)n++});count.textContent=n+' conversation(s)';empty.hidden=n!==0;};query.addEventListener('input',apply);cycle.addEventListener('change',apply);document.getElementById('conversation-reset').addEventListener('click',()=>{query.value='';cycle.value='';apply();query.focus()});apply();})();
</script></body></html>
