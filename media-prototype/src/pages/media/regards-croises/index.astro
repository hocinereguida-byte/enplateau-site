---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, publicationInstant } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
const articles=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.format==='regard-croise').sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Le fond du problème — Scènes d’Arbitrage</title><meta name="description" content="Les faits, les chiffres et les mécanismes économiques derrière les sujets qui fâchent. Des analyses journalistiques autonomes, sourcées et non satiriques."/><style is:inline set:html={articleStyle}/></head><body class="media-home"><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main id="contenu" class="home-shell"><section class="home-intro"><p class="micro">SCÈNES D’ARBITRAGE · ANALYSE JOURNALISTIQUE</p><h1>Le fond du problème</h1><p class="home-standfirst">Les faits, les chiffres et les mécanismes économiques derrière les sujets qui fâchent. Des analyses journalistiques autonomes, sourcées et non satiriques.</p><div class="intro-links"><a href="/media/">Retour à la une</a><a href="/media/scenes/">Explorer les fictions satiriques</a></div></section><section class="home-section" aria-label="Articles du fond du problème"><div class="cycle-list">{articles.map(a=><a class="cycle-row" href={urlOf(a.id)}><span class="cycle-index">ANALYSE JOURNALISTIQUE</span><span class="cycle-title">{a.data.title}</span><span class="cycle-description">{a.data.summary}</span><span class="cycle-arrow" aria-hidden="true">↗</span></a>)}</div>{articles.length===0&&<p>Aucune publication disponible dans cette rubrique pour le moment.</p>}</section></main><MediaFooter/></body></html>