---
import { getCollection } from 'astro:content';
import { isPublic, validClassification, urlOf, readings, publicationInstant } from '../../../lib/editorial';
import { articleStyle } from '../../../lib/article-style';
import MediaHeader from '../../../components/MediaHeader.astro';
import MediaFooter from '../../../components/MediaFooter.astro';
const articles=(await getCollection('articles')).filter(a=>isPublic(a.data)&&validClassification(a.data)&&a.data.format==='regard-croise').sort((a,b)=>(publicationInstant(b.data.publication_date)?.getTime()??0)-(publicationInstant(a.data.publication_date)?.getTime()??0));
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Regards croisés — Scènes d’Arbitrage</title><meta name="description" content="Des articles d’analyse autonomes fondés sur des données, des travaux et des références réelles. La fiction pose les questions ; l’analyse examine les mécanismes."/><style is:inline set:html={articleStyle}/></head><body class="media-home"><a class="skip" href="#contenu">Aller au contenu</a><MediaHeader/><main id="contenu" class="home-shell"><section class="home-intro"><p class="micro">SCÈNES D’ARBITRAGE · ANALYSE JOURNALISTIQUE</p><h1>Regards croisés</h1><p class="home-standfirst">Des articles d’analyse autonomes fondés sur des données, des travaux et des références réelles. La fiction pose les questions ; l’analyse examine les mécanismes.</p><div class="intro-links"><a href="/media/">Retour à la une</a><a href="/media/scenes/">Explorer les Scènes</a></div></section><section class="home-section" aria-label="Articles Regards croisés"><div class="cycle-list">{articles.map(a=><a class="cycle-row" href={urlOf(a.id)}><span class="cycle-index">REGARD CROISÉ</span><span class="cycle-title">{a.data.title}</span><span class="cycle-description">{a.data.summary} · {readings[a.data.lecture_principale]}</span><span class="cycle-arrow" aria-hidden="true">↗</span></a>)}</div>{articles.length===0&&<p>Aucune publication disponible dans cette rubrique pour le moment.</p>}</section></main><MediaFooter/></body></html>