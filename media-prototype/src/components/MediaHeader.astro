#press-site-header.press-header{grid-template-columns:185px auto!important;padding:0 14px!important}
#press-site-header .press-masthead p{display:none!important}
#press-site-header .press-logo-image{max-width:172px!important;height:46px!important}
#press-site-header .press-home-link,#press-site-header .press-dropdown>summary,#press-site-header .press-search{padding:18px 7px!important;font-size:11px!important}
}


/* UX V5 ajustement du logotype typographique */
#press-site-header .press-wordmark{color:#f7f4ee!important;font:600 24px/1 Georgia,'Times New Roman',serif!important;letter-spacing:-.05em!important;white-space:nowrap}
#press-site-header .press-wordmark-mobile{font-size:21px!important}
@media(max-width:380px){#press-site-header .press-wordmark-mobile{font-size:19px!important}}
</style>
<script is:inline>
const pressHeader=document.getElementById('press-site-header');
const pressToggle=pressHeader?.querySelector('.press-menu-toggle');
const pressNav=pressHeader?.querySelector('.press-nav');
const closeMobileMenu=()=>{pressHeader?.classList.remove('press-menu-open');pressToggle?.setAttribute('aria-expanded','false');const icon=pressToggle?.querySelector('.press-toggle-icon');const label=pressToggle?.querySelector('.press-toggle-label');if(icon)icon.textContent='☰';if(label)label.textContent='Menu';};
pressToggle?.addEventListener('click',()=>{const open=!pressHeader.classList.contains('press-menu-open');if(open){pressHeader.classList.add('press-menu-open');pressToggle.setAttribute('aria-expanded','true');pressToggle.querySelector('.press-toggle-icon').textContent='×';pressToggle.querySelector('.press-toggle-label').textContent='Fermer';}else closeMobileMenu();});
window.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMobileMenu();pressHeader?.querySelectorAll('details').forEach(d=>d.open=false);pressToggle?.focus();}});
window.matchMedia('(min-width:761px)').addEventListener('change',e=>{if(e.matches)closeMobileMenu();});
pressNav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMobileMenu));
document.querySelectorAll('.press-nav > details').forEach(detail=>{
 detail.addEventListener('toggle',()=>{if(detail.open)document.querySelectorAll('.press-nav > details').forEach(other=>{if(other!==detail)other.open=false})});
});
document.addEventListener('click',event=>{if(!event.target.closest('.press-nav'))document.querySelectorAll('.press-nav details').forEach(d=>d.open=false)});
</script>