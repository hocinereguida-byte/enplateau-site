---
const {active=''}=Astro.props;
---
<header class="press-header">
 <div class="press-utility"><span>REGARDS SUR LES DÉCISIONS ÉCONOMIQUES</span><div><a href="/media/institution/qui-sommes-nous/">Le média</a><a href="/media/newsletter/">Newsletter</a><a href="/media/proposer-un-eclairage/">Contribuer</a></div></div>
 <div class="press-masthead"><a class="press-logo" href="/media/" aria-label="Scènes d’Arbitrage, accueil">Scènes d’Arbitrage</a><p>Comprendre les décisions. Croiser les regards.</p></div>
 <nav class="press-nav" aria-label="Navigation principale"><div class="press-nav-links"><a href="/media/" aria-current={active==='accueil'?'page':undefined}>Accueil</a><a href="/media/cycles/industrie/">Industrie</a><a href="/media/cycles/immobilier/">Immobilier</a><a href="/media/#lectures">Lectures professionnelles</a><a href="/media/publications/">Toutes les publications</a></div><a class="press-search" href="/media/publications/" aria-label="Rechercher une publication"><span aria-hidden="true">⌕</span> Rechercher</a></nav>
</header>
<style is:global>
.press-header{background:#0a1119;color:#eaf1f6;border-bottom:3px solid #1d6aa3;font-family:'IBM Plex Sans',Arial,sans-serif}
.press-utility{max-width:1200px;margin:auto;padding:10px 24px;display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #314053;font:500 10px/1.5 'IBM Plex Mono',monospace;letter-spacing:.07em;color:#a7bace}
.press-utility>div{display:flex;gap:18px}.press-header a{color:inherit;text-decoration:none}.press-header a:hover,.press-header a:focus-visible{color:#90c6f0;text-decoration:underline}
.press-masthead{text-align:center;padding:28px 20px 24px}.press-logo{display:inline-block;font:600 clamp(28px,4vw,54px)/1.12 'Playfair Display',Georgia,serif;letter-spacing:-.025em}.press-masthead p{margin:10px 0 0;font:400 11px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#b5c7d4}
.press-nav{border-top:1px solid #344251;max-width:1200px;margin:0 auto;padding:0 24px;display:flex;justify-content:space-between;align-items:center;gap:15px}.press-nav-links{display:flex;flex-wrap:wrap;gap:0}.press-nav-links a{display:block;padding:14px 17px;font:600 13px 'IBM Plex Sans',Arial,sans-serif;border-right:1px solid #263849}.press-nav-links a:first-child{padding-left:0}.press-nav-links a[aria-current=page]{color:#9bcaf0}.press-search{font-size:12px;white-space:nowrap}
@media(max-width:700px){.press-utility{padding:8px 15px}.press-utility>span{display:none}.press-utility>div{width:100%;justify-content:space-between}.press-masthead{padding:21px 14px}.press-logo{font-size:31px}.press-masthead p{font-size:9px}.press-nav{padding:0 11px;align-items:stretch;flex-direction:column;gap:0}.press-nav-links{display:flex;flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin}.press-nav-links a{white-space:nowrap;padding:13px 12px;font-size:12px}.press-nav-links a:first-child{padding-left:5px}.press-search{padding:8px 5px;border-top:1px solid #293c4d;text-align:right}}
</style>