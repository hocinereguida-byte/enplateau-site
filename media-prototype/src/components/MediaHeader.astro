---
import { readings, cycleCatalogue, cycleFamilies } from '../lib/editorial';
const {active=''}=Astro.props;
const groupedCycles=cycleFamilies.map(f=>({label:f.label,items:f.codes.map(code=>cycleCatalogue.find(c=>c.code===code)).filter(Boolean)}));
---
<header class="press-header" id="press-site-header">
 <div class="press-utility"><span>L’INTELLIGENCE DERRIÈRE LES DÉCISIONS</span><div><a href="/media/institution/qui-sommes-nous/">Le média</a><a href="/media/newsletter/">Newsletter</a><a href="/media/proposer-un-eclairage/">Contribuer</a></div></div>
 <div class="press-masthead"><a class="press-logo" href="/media/" aria-label="Scènes d’Arbitrage, accueil"><span class="press-wordmark" aria-hidden="true">Scènes d’Arbitrage</span></a><p>La fiction pour explorer. L’analyse pour comprendre.</p></div>
 <div class="press-mobile-bar"><a class="press-mobile-brand" href="/media/" aria-label="Scènes d’Arbitrage — accueil"><span class="press-wordmark press-wordmark-mobile" aria-hidden="true">Scènes d’Arbitrage</span></a><div class="press-mobile-actions"><a class="press-mobile-search" href="/media/publications/" aria-label="Rechercher des publications">⌕</a><button class="press-menu-toggle" type="button" aria-controls="press-main-navigation" aria-expanded="false"><span class="press-toggle-icon" aria-hidden="true">☰</span><span class="press-toggle-label">Menu</span></button></div></div>
 <nav class="press-nav" id="press-main-navigation" aria-label="Navigation principale">
  <a class="press-home-link" href="/media/" aria-current={active==='accueil'?'page':undefined}>À la une</a>
  <details class="press-dropdown"><summary>Cycles <span aria-hidden="true">⌄</span></summary><div class="press-dropdown-content press-cycle-dropdown"><strong>Explorer par grande famille</strong><div class="press-cycle-groups">{groupedCycles.map(f=><details class="press-cycle-family"><summary>{f.label} <span aria-hidden="true">›</span></summary><div>{f.items.map(item=><a href={`/media/cycles/${item.code}/`}>{item.label}</a>)}</div></details>)}</div><a class="press-dropdown-more" href="/media/cycles/">Voir les 20 cycles</a></div></details>

  <a class="press-home-link" href="/media/conversations/">Conversations</a>
  <details class="press-dropdown"><summary>Genres <span aria-hidden="true">⌄</span></summary><div class="press-dropdown-content"><strong>Choisir sa lecture</strong><a href="/media/scenes/#chronique">Chroniques</a><a href="/media/scenes/#grand-entretien">Grands Entretiens</a><a href="/media/regards-croises/">Regards croisés</a><a class="press-dropdown-more" href="/media/lectures/">Explorer par perspective</a><a href="/media/publications/">Toutes les publications</a></div></details>
  <a class="press-home-link" href="/media/institution/qui-sommes-nous/">Le média</a>
  <a class="press-search" href="/media/publications/" aria-label="Rechercher des publications"><span aria-hidden="true">⌕</span> Rechercher</a>
 </nav>
</header>
<style is:global>
/* V7 — presse économique claire et méga-menu */
.press-header{background:#fff1e5!important;color:#262a33!important;border-bottom:2px solid #262a33!important}
.press-utility{color:#61564e!important;border-bottom-color:#d8c4b5!important}
.press-masthead{padding:22px 20px 17px!important}
.press-masthead p{color:#64584f!important}
.press-nav{border-top:1px solid #d8c4b5!important}
.press-home-link,.press-dropdown>summary,.press-search{color:#262a33!important}
.press-dropdown[open]>summary{background:#ecd6c7!important;color:#176b78!important}
.press-dropdown-content{background:#fff7ef!important;color:#262a33!important;border-color:#cbb9ab!important;box-shadow:0 14px 28px #34221830!important}
.press-dropdown-content strong{color:#66574d!important}
.press-dropdown-content a{color:#262a33!important}
.press-cycle-dropdown{width:min(1050px,calc(100vw - 48px))!important;max-width:none!important;max-height:75vh;overflow-y:auto;left:0}
.press-cycle-groups{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:10px 24px!important}
.press-cycle-family summary{color:#262a33!important;border-bottom:1px solid #dbc9ba}
.press-cycle-family{border-bottom-color:#dbc9ba!important}
.press-cycle-family>div{border-left-color:#176b78!important}
.press-cycle-family>div a{color:#36302c!important}
.press-mobile-bar{background:#fff1e5!important}
.press-menu-toggle,.press-mobile-search{color:#262a33!important}
@media(min-width:761px){.press-dropdown:has(.press-cycle-dropdown){position:static}.press-nav{position:relative}.press-cycle-dropdown{left:50%!important;transform:translateX(-50%);top:100%!important}}
@media(max-width:760px){.press-nav{background:#fff1e5!important;border-top-color:#d6c3b3!important}.press-home-link,.press-dropdown>summary,.press-search{border-bottom-color:#dccbbd!important}.press-cycle-dropdown{position:static!important;transform:none!important;width:100%!important;max-height:none!important;overflow:visible!important}.press-cycle-groups{display:block!important}.press-dropdown-content{box-shadow:none!important}}

.press-logo-image{display:block;width:auto;height:auto;max-height:76px;max-width:min(520px,80vw);object-fit:contain;margin:0 auto}.press-mobile-logo{display:block;max-width:min(240px,65vw);max-height:47px;width:auto;height:auto;object-fit:contain}

.press-cycle-dropdown{width:min(690px,calc(100vw - 40px));min-width:0;max-width:none;max-height:min(75vh,680px);overflow-y:auto}.press-cycle-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px 18px}.press-cycle-family{min-width:0}.press-cycle-family summary,.press-cycle-family a{overflow-wrap:anywhere;word-break:normal}.press-cycle-family summary{display:flex;align-items:start;justify-content:space-between;gap:12px}.press-cycle-family summary span{float:none;flex-shrink:0}.press-cycle-family{border-bottom:1px solid #36516b}.press-cycle-family summary{cursor:pointer;list-style:none;font:600 12px/1.5 "IBM Plex Sans",sans-serif;padding:10px 4px;color:#eaf1f6}.press-cycle-family summary::-webkit-details-marker{display:none}.press-cycle-family summary span{float:right}.press-cycle-family[open] summary{color:#9bcaf0}.press-cycle-family>div{padding:0 0 6px 9px;border-left:2px solid #317cb5}.press-cycle-family>div a{font-size:12px}.press-cycle-dropdown>.press-dropdown-more{grid-column:1/-1}@media(max-width:760px){.press-cycle-dropdown{width:100%;min-width:0;max-width:none;max-height:none;overflow:visible}.press-cycle-groups{display:block}.press-cycle-family summary{font-size:14px;padding:13px 4px}}

.press-header{position:sticky;top:0;z-index:100;background:#0a1119;color:#eaf1f6;border-bottom:3px solid #1d6aa3;font-family:'IBM Plex Sans',Arial,sans-serif}
.press-utility{max-width:1200px;margin:auto;padding:10px 24px;display:flex;justify-content:space-between;gap:20px;border-bottom:1px solid #314053;font:500 10px/1.5 'IBM Plex Mono',monospace;letter-spacing:.07em;color:#a7bace}
.press-utility>div{display:flex;gap:18px}.press-header a{color:inherit;text-decoration:none}.press-header a:hover,.press-header a:focus-visible{color:#90c6f0;text-decoration:underline}
.press-masthead{text-align:center;padding:28px 20px 24px}.press-logo{display:inline-block;font:600 clamp(28px,4vw,54px)/1.12 'Playfair Display',Georgia,serif;letter-spacing:-.025em}.press-masthead p{margin:10px 0 0;font:400 11px 'IBM Plex Mono',monospace;letter-spacing:.08em;color:#b5c7d4}
.press-nav{border-top:1px solid #344251;max-width:1200px;margin:0 auto;padding:0 24px;display:flex;align-items:stretch;gap:0}.press-home-link,.press-dropdown>summary,.press-search{padding:16px 15px;display:flex;align-items:center;gap:7px;color:#eaf1f6;white-space:nowrap;font:600 13px 'IBM Plex Sans',Arial,sans-serif;cursor:pointer}.press-home-link[aria-current=page]{color:#9bcaf0}.press-dropdown{position:relative}.press-dropdown>summary{list-style:none}.press-dropdown>summary::-webkit-details-marker{display:none}.press-dropdown[open]>summary{background:#183247;color:#a7d6f4}.press-dropdown-content{position:absolute;top:100%;left:0;z-index:12;background:#112438;border:1px solid #36516b;box-shadow:0 12px 24px #0006;min-width:240px;max-width:min(370px,90vw);padding:16px;display:flex;flex-direction:column;gap:1px}.press-dropdown-wide{min-width:330px;display:grid;grid-template-columns:1fr 1fr;gap:4px 15px}.press-dropdown-content strong{grid-column:1/-1;font:600 10px 'IBM Plex Mono',monospace;color:#a8bed0;letter-spacing:.07em;text-transform:uppercase;margin:0 0 8px}.press-dropdown-content a{display:block;padding:9px 7px;white-space:normal;font:13px/1.35 'IBM Plex Sans',Arial,sans-serif}.press-dropdown-more{border-top:1px solid #3b5063;margin-top:8px;grid-column:1/-1}.press-search{margin-left:auto}
.press-mobile-bar{display:none}
@media(max-width:760px){
.press-header{position:sticky;top:0;z-index:100;border-bottom:2px solid #1d6aa3}
.press-utility,.press-masthead{display:none!important}
.press-mobile-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:58px;padding:0 16px}
.press-mobile-brand{font:600 clamp(19px,5.6vw,27px)/1.1 'Playfair Display',Georgia,serif;letter-spacing:-.02em;white-space:nowrap}
.press-mobile-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
.press-mobile-search{font:30px/1 'IBM Plex Sans',Arial,sans-serif;padding:10px 9px}
.press-menu-toggle{appearance:none;display:flex;align-items:center;gap:7px;padding:10px 0 10px 8px;border:0;background:transparent;color:#eaf1f6;font:600 13px 'IBM Plex Sans',Arial,sans-serif;cursor:pointer}
.press-toggle-icon{font-size:21px;line-height:1}
.press-nav{display:none!important;position:absolute;top:100%;left:0;right:0;max-width:none;width:100%;max-height:calc(100dvh - 58px);overflow-y:auto;overscroll-behavior:contain;background:#0a1119;border-top:1px solid #354a5e;box-shadow:0 18px 30px #0008;padding:7px 16px 18px;flex-direction:column;align-items:stretch}
.press-header.press-menu-open .press-nav{display:flex!important}
.press-home-link,.press-dropdown>summary,.press-search{padding:14px 4px;border-bottom:1px solid #2e4356;justify-content:space-between;font-size:15px}
.press-dropdown-content,.press-dropdown-wide{position:static;display:flex;box-shadow:none;border:0;border-left:2px solid #317cb5;max-width:none;min-width:0;width:100%;padding:8px 12px;margin:0 0 8px}
.press-dropdown-content a{padding:10px 7px}.press-search{margin-left:0}
}
@media(prefers-reduced-motion:no-preference){.press-mobile-bar{transition:background-color .15s}}

/* V7 correctifs masthead et navigation, appliqués après les règles historiques */
.press-logo-image,.press-mobile-logo{filter:brightness(0) saturate(100%)!important}
.press-masthead{padding:12px 20px 13px!important}
.press-logo-image{height:88px!important;max-height:88px!important;max-width:min(600px,85vw)!important;width:auto!important}
.press-mobile-logo{height:43px!important;max-height:43px!important;max-width:min(250px,60vw)!important;width:auto!important}
.press-nav{position:relative!important}
@media(min-width:761px){
.press-nav>.press-dropdown:has(.press-cycle-dropdown){position:static!important}
.press-nav .press-dropdown-content.press-cycle-dropdown{display:block!important;box-sizing:border-box!important;width:min(980px,calc(100vw - 64px))!important;min-width:min(980px,calc(100vw - 64px))!important;max-width:none!important;left:50%!important;right:auto!important;top:100%!important;transform:translateX(-50%)!important;padding:24px 30px!important;overflow-y:auto!important}
.press-nav .press-cycle-groups{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;column-gap:28px!important;row-gap:15px!important}
.press-nav .press-cycle-family{min-width:0!important}
.press-nav .press-cycle-family summary{overflow-wrap:normal!important;word-break:normal!important;hyphens:none!important;white-space:normal!important;font-size:14px!important;line-height:1.45!important}
.press-nav .press-cycle-family>div a{overflow-wrap:normal!important;word-break:normal!important;hyphens:none!important;white-space:normal!important;font-size:13px!important}
}
@media(max-width:760px){
.press-nav .press-dropdown-content.press-cycle-dropdown{display:block!important;width:100%!important;min-width:0!important;max-width:none!important;transform:none!important;left:auto!important;padding:12px!important}
.press-nav .press-cycle-groups{display:block!important}
.press-nav .press-cycle-family summary{overflow-wrap:normal!important;word-break:normal!important;hyphens:none!important}
}

/* Header FT V7.2 : logo volontairement agrandi et stable */
.press-logo-image{height:150px!important;max-height:150px!important;width:auto!important;max-width:min(780px,90vw)!important;object-fit:contain!important}
.press-masthead{padding:7px 20px 12px!important}.press-masthead p{margin-top:0!important}
@media(max-width:760px){.press-mobile-logo{height:54px!important;max-height:54px!important;max-width:70vw!important}}

/* UX V5 — nouvelle identité de navigation : sobre, sombre, mobile-first */
#press-site-header.press-header{background:#1b1b19!important;color:#f7f4ee!important;border-bottom:1px solid #35342f!important;box-shadow:none!important;display:grid;grid-template-columns:minmax(200px,1fr) auto;align-items:center;min-height:78px;padding:0 max(22px,calc((100vw - 1120px)/2))!important;position:sticky;top:0}
#press-site-header .press-utility{display:none!important}
#press-site-header .press-masthead{display:flex!important;align-items:center;gap:18px;min-width:0;text-align:left!important;padding:8px 0!important}
#press-site-header .press-masthead p{display:block;font:500 9px/1.5 'IBM Plex Mono',monospace!important;letter-spacing:.12em!important;max-width:150px;margin:0!important;color:#c2beb7!important}
#press-site-header .press-logo{flex-shrink:0}
#press-site-header .press-logo-image{filter:brightness(0) invert(1)!important;height:50px!important;max-height:50px!important;max-width:200px!important;width:auto!important}
#press-site-header .press-nav{position:relative!important;background:transparent!important;border:0!important;max-width:none!important;padding:0!important;margin:0!important;display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:0!important}
#press-site-header .press-home-link,#press-site-header .press-dropdown>summary,#press-site-header .press-search{color:#f2efe8!important;font:600 12px/1.4 'IBM Plex Sans',Arial,sans-serif!important;padding:20px 10px!important;border:0!important}
#press-site-header .press-home-link:hover,#press-site-header .press-dropdown>summary:hover,#press-site-header .press-search:hover{color:#e49b87!important;text-decoration:none!important}
#press-site-header .press-home-link[aria-current=page]{color:#e49b87!important}
#press-site-header .press-dropdown[open]>summary{background:#34332f!important;color:#fff!important}
#press-site-header .press-dropdown-content{background:#262622!important;color:#eee!important;border:1px solid #45443e!important;box-shadow:0 12px 25px #0007!important}
#press-site-header .press-dropdown-content strong{color:#c98570!important}
#press-site-header .press-dropdown-content a,#press-site-header .press-cycle-family summary{color:#eee!important;font-size:12px!important}
#press-site-header .press-dropdown-content a:hover{color:#eaa391!important;background:#373630!important}
#press-site-header .press-cycle-family{border-bottom-color:#47453d!important}
#press-site-header .press-cycle-family summary{border-bottom-color:#47453d!important}
#press-site-header .press-cycle-family>div{border-left-color:#b95e45!important}
#press-site-header .press-cycle-dropdown{background:#262622!important}
#press-site-header .press-mobile-bar{display:none!important}
@media(max-width:760px){
#press-site-header.press-header{display:block!important;min-height:60px!important;padding:0!important}
#press-site-header .press-masthead{display:none!important}
#press-site-header .press-mobile-bar{display:flex!important;min-height:60px!important;background:#1b1b19!important;padding:0 15px!important}
#press-site-header .press-mobile-logo{filter:brightness(0) invert(1)!important;height:43px!important;max-height:43px!important;max-width:175px!important}
#press-site-header .press-menu-toggle,#press-site-header .press-mobile-search{color:#eee!important}
#press-site-header .press-nav{display:none!important;position:absolute!important;top:100%!important;left:0!important;right:0!important;max-height:calc(100dvh - 60px)!important;overflow-y:auto!important;background:#1b1b19!important;padding:10px 17px 22px!important;flex-direction:column!important;align-items:stretch!important;box-shadow:0 18px 30px #0008!important;border-top:1px solid #3a3833!important}
#press-site-header.press-menu-open .press-nav{display:flex!important}
#press-site-header .press-home-link,#press-site-header .press-dropdown>summary,#press-site-header .press-search{font-size:15px!important;padding:16px 4px!important;border-bottom:1px solid #3e3d39!important}
#press-site-header .press-dropdown[open]>summary{background:#34322e!important;padding-left:10px!important}
#press-site-header .press-dropdown-content{background:#242420!important;border:0!important;border-left:2px solid #b85d44!important;box-shadow:none!important}
#press-site-header .press-cycle-dropdown{background:#242420!important;padding:12px!important}
#press-site-header .press-cycle-family summary{padding:13px 4px!important;font-size:14px!important}
#press-site-header .press-dropdown-content a{font-size:14px!important}
}
